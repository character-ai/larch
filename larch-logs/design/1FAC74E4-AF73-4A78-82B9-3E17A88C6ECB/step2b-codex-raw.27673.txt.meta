OUTER_LAUNCHER_SANDBOX=read-only
OUTER_LAUNCHER_WITH_EFFORT=false
OUTER_LAUNCHER_USAGE_LABEL=codex_plan_draft
OUTER_LAUNCHER_TIMING_KIND=codex-plan-draft
