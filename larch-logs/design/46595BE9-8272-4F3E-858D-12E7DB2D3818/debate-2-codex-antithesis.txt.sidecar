    53	    larch_err "design-driver.sh: --action-file is missing or unreadable: $ACTION_FILE"
    54	    exit 2
    55	fi
    56	mkdir -p "$DESIGN_TMPDIR/.completed"
    57	
    58	normalize_step() {
    59	    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-'
    60	}
    61	
    62	extract_args() {
    63	    local line="$1"
    64	    case "$line" in
    65	        *' ARGS='*) printf '%s' "${line#* ARGS=}" ;;
    66	        *) printf '%s' "" ;;
    67	    esac
