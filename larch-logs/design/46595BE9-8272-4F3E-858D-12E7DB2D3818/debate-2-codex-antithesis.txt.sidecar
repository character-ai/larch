     1	#!/usr/bin/env bash
     2	# create-pr.sh — Push branch and create a GitHub PR.
     3	#
     4	# Checks for an existing open PR on the current branch first.
     5	# If none exists, pushes the branch and creates a new PR.
     6	#
     7	# Usage:
     8	#   create-pr.sh --title TEXT --body-file FILE [--draft] [--repo OWNER/REPO] [--base BASE_REF]
     9	#
    10	# Arguments:
    11	#   --title     — PR title (under 70 chars recommended)
    12	#   --body-file — Path to a file containing the PR body (markdown)
    13	#   --draft     — Create the PR in draft state (optional)
    14	#   --base      — Base branch for new PRs (optional; defaults to repo default branch, then main)
    15	#
    16	# Outputs (key=value to stdout):
    17	#   PR_NUMBER=<N>
    18	#   PR_URL=<url>
    19	#   PR_TITLE=<title>
    20	#   PR_STATUS=created|existing
    21	#
    22	# Exit codes:
    23	#   0 — success (PR created or already exists)
    24	#   1 — push failed or dirty-tree guard aborted before push
    25	#   2 — guard/setup/PR creation failed
    26	
    27	set -euo pipefail
    28	
    29	SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    30	# shellcheck source=scripts/lib-quiet.sh
    31	source "$SCRIPT_DIR/lib-quiet.sh"
    32	larch_quiet_init
    33	REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
    34	REDACT_TMPDIR_HELPER="$REPO_ROOT/scripts/redact-tmpdir-paths.sh"
    35	
    36	PUSH_STDERR=""
    37	GIT_STATUS_STDERR=""
    38	PR_STDERR_FILE=""
    39	PR_STDOUT_FILE=""
    40	REDACTED_BODY_FILE=""
    41	cleanup() {
    42	    rm -f "$PUSH_STDERR" "$GIT_STATUS_STDERR" "$PR_STDERR_FILE" "$PR_STDOUT_FILE" "$REDACTED_BODY_FILE"
    43	}
    44	trap cleanup EXIT
    45	
    46	usage() { larch_err "Usage: create-pr.sh --title TEXT --body-file FILE [--draft] [--repo OWNER/REPO] [--base BASE_REF]"; }
    47	
    48	TITLE=""
    49	BODY_FILE=""
    50	DRAFT=false
    51	TARGET_REPO=""
    52	BASE_REF=""
    53	while [[ $# -gt 0 ]]; do
    54	    case "$1" in
    55	        --title) TITLE="${2:?--title requires a value}"; shift 2 ;;
    56	        --body-file) BODY_FILE="${2:?--body-file requires a value}"; shift 2 ;;
    57	        --draft) DRAFT=true; shift ;;
    58	        --repo) TARGET_REPO="${2:?--repo requires a value}"; shift 2 ;;
    59	        --base) BASE_REF="${2:?--base requires a value}"; shift 2 ;;
    60	        --help) usage; exit 0 ;;
    61	        *) larch_err "Unknown option: $1"; usage; exit 2 ;;
    62	    esac
    63	done
    64	
    65	if [[ -z "$TITLE" ]] || [[ -z "$BODY_FILE" ]]; then
    66	    larch_err "ERROR: --title and --body-file are required"
    67	    usage; exit 2
    68	fi
    69	
    70	if [[ ! -f "$BODY_FILE" ]]; then
    71	    larch_err "ERROR: Body file not found: $BODY_FILE"
    72	    exit 2
    73	fi
    74	
    75	GH_REPO_ARGS=()
    76	if [[ -z "$TARGET_REPO" ]]; then
    77	    TARGET_REPO=$("$SCRIPT_DIR/resolve-repo.sh" 2>/dev/null) || TARGET_REPO=""
    78	fi
    79	if [[ -n "$TARGET_REPO" ]]; then
    80	    if [[ ! "$TARGET_REPO" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
    81	        larch_err "ERROR: --repo must be OWNER/REPO using GitHub owner/repo characters"
    82	        exit 2
    83	    fi
    84	    GH_REPO_ARGS=(--repo "$TARGET_REPO")
    85	fi
    86	
    87	if [[ ! -x "$REDACT_TMPDIR_HELPER" ]]; then
    88	    larch_err "ERROR: Redaction helper missing or not executable: redact-tmpdir-paths.sh"
    89	    exit 2
    90	fi
    91	REDACTED_BODY_FILE=$(mktemp)
    92	if ! "$REDACT_TMPDIR_HELPER" < "$BODY_FILE" > "$REDACTED_BODY_FILE"; then
    93	    larch_err "ERROR: Failed to redact PR body tmpdir paths"
    94	    exit 2
    95	fi
    96	
    97	# Pre-push clean-tree guard: uncommitted working-tree changes are silently
    98	# excluded from a push, causing data loss (issue #2434).
    99	GIT_STATUS_STDERR=$(mktemp)
   100	if ! DIRTY_FILES=$(git status --porcelain 2>"$GIT_STATUS_STDERR"); then
   101	    larch_err "ERROR: Failed to inspect working tree before push: $(cat "$GIT_STATUS_STDERR")"
   102	    exit 2
   103	fi
   104	if [[ -n "$DIRTY_FILES" ]]; then
   105	    larch_err "ERROR: Uncommitted working-tree changes detected before push. These will NOT be included in the merged PR. Stage and commit them, or discard them, before pushing."
   106	    larch_err "$DIRTY_FILES"
   107	    exit 1
   108	fi
   109	
   110	# --- Get current branch ---
   111	BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
   112	if [[ -z "$BRANCH" ]]; then
   113	    larch_err "ERROR: Not on a branch (detached HEAD)"
   114	    exit 2
   115	fi
   116	
   117	# --- Check for existing open PR ---
   118	EXISTING_PR=$(gh pr view ${GH_REPO_ARGS[@]+"${GH_REPO_ARGS[@]}"} --json number,url,state,title 2>/dev/null || echo "")
   119	if [[ -n "$EXISTING_PR" ]]; then
   120	    PR_STATE=$(echo "$EXISTING_PR" | jq -r '.state // empty' 2>/dev/null || echo "")

