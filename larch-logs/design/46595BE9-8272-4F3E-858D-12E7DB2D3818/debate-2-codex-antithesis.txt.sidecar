     1	#!/usr/bin/env bash
     2	# merge-pr.sh - Squash-merge a PR, trying --admin first after safety gates.
     3	#
     4	# Checks whether the branch is behind main and whether CI is ready before
     5	# any merge attempt. If CI is confirmed passing and the branch is
     6	# up-to-date, tries `gh pr merge --squash --admin` first, then falls back
     7	# to a plain squash merge if the privileged attempt fails. When
     8	# --no-admin-fallback is set, skips the privileged attempt and tries only
     9	# the plain squash merge; if that fails, returns MERGE_RESULT=policy_denied.
    10	#
    11	# CRITICAL: The --admin flag overrides ALL branch protection rules
    12	# including review requirements. It is ONLY used after confirming:
    13	#   1. All CI checks are passing (bucket == "pass" for every check)
    14	#   2. The branch is up-to-date with main and in an admin-eligible state
    15	# This is the canonical --admin implementation.
    16	# See skills/implement/SKILL.md Step 12b for usage documentation.
    17	#
    18	# Usage:
    19	#   merge-pr.sh --pr NUMBER --repo OWNER/REPO [--no-admin-fallback]
    20	#
    21	# --no-admin-fallback: opts out of the --admin-first attempt. When set,
    22	#   the script reaches the same admin-eligible gate (CI good + branch
    23	#   fresh) but invokes only `gh pr merge --squash`; if that plain merge
    24	#   fails, it emits MERGE_RESULT=policy_denied. This applies to ALL
    25	#   admin-eligible mergeStateStatus values (CLEAN, UNSTABLE, HAS_HOOKS,
    26	#   BLOCKED) — not just review-required denials.
    27	#
    28	# Outputs (key=value to stdout, always emitted via EXIT trap):
    29	#   MERGE_RESULT=merged|admin_merged|main_advanced|ci_not_ready|version_already_published|admin_failed|policy_denied|error
    30	#   ERROR=<message>    (empty string when no error)
    31	#
    32	# version_already_published fires only after the PR-head-OID precondition
    33	# succeeds, the branch range contains a literal "Bump version to X.Y.Z" commit,
    34	# and origin/main's published plugin.json version matches that local bump.
    35	#
    36	# Exit codes:
    37	#   0 — always (result communicated via MERGE_RESULT)
    38	#   1 — usage/argument error (no output emitted)
    39	
    40	set -uo pipefail
    41	
    42	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    43	# shellcheck source=scripts/lib-quiet.sh
    44	source "$SCRIPT_DIR/lib-quiet.sh"
    45	larch_quiet_init
    46	
    47	usage() { larch_err "Usage: merge-pr.sh --pr NUMBER --repo OWNER/REPO [--no-admin-fallback]"; }
    48	
    49	# --- Parse arguments (before installing EXIT trap) ---
    50	PR_NUMBER=""
    51	REPO=""
    52	NO_ADMIN_FALLBACK=false
    53	while [[ $# -gt 0 ]]; do
    54	    case "$1" in
    55	        --pr) PR_NUMBER="${2:?--pr requires a value}"; shift 2 ;;
    56	        --repo) REPO="${2:?--repo requires a value}"; shift 2 ;;
    57	        --no-admin-fallback) NO_ADMIN_FALLBACK=true; shift ;;
    58	        --help) usage; exit 0 ;;
    59	        *) larch_err "Unknown option: $1"; usage; exit 1 ;;
    60	    esac
    61	done
    62	
    63	if [[ -z "$PR_NUMBER" ]] || [[ -z "$REPO" ]]; then
    64	    larch_err "ERROR: --pr and --repo are required"
    65	    usage; exit 1
    66	fi
    67	
    68	# --- Output defaults (emitted via trap on any exit after validation) ---
    69	MERGE_RESULT="error"
    70	ERROR="merge-pr.sh exited unexpectedly"
    71	
    72	# shellcheck disable=SC2329,SC2317  # invoked via EXIT trap
    73	emit_output() {
    74	    emit_kv MERGE_RESULT "$MERGE_RESULT"
    75	    emit_kv ERROR "$ERROR"
    76	}
    77	trap 'emit_output' EXIT
    78	
    79	refresh_pr_info() {
    80	    PR_INFO=$(gh pr view "$PR_NUMBER" --repo "$REPO" --json mergeStateStatus,headRefOid 2>/dev/null || echo "")
    81	    MERGE_STATE=$(echo "$PR_INFO" | jq -r '.mergeStateStatus // ""' 2>/dev/null || echo "")
    82	    PR_HEAD_OID=$(echo "$PR_INFO" | jq -r '.headRefOid // ""' 2>/dev/null || echo "")
    83	}
    84	
    85	refresh_ci_state() {
    86	    # Use gh pr checks --json with bucket field (consistent with ci-status.sh)
    87	    CHECKS_JSON=$(gh pr checks "$PR_NUMBER" --repo "$REPO" --json name,state,bucket,link 2>/dev/null || echo "")
    88	
    89	    CI_GOOD=false
    90	    if [[ -n "$CHECKS_JSON" ]] && [[ "$CHECKS_JSON" != "null" ]] \
    91	        && echo "$CHECKS_JSON" | jq -e 'type == "array"' >/dev/null 2>&1; then
    92	        TOTAL=$(echo "$CHECKS_JSON" | jq 'length' 2>/dev/null || echo "0")
    93	
    94	        if [[ "$TOTAL" -eq 0 ]]; then
    95	            # Zero checks — conservative: treat as not ready
    96	            CI_GOOD=false
    97	        else
    98	            # Require every check to have bucket == "pass" (not just absence of fail/pending).
    99	            # This rejects cancelled, skipping, or any other non-pass bucket.
   100	            PASSED=$(echo "$CHECKS_JSON" | jq '[.[] | select(.bucket == "pass")] | length' 2>/dev/null || echo "0")
   101	
   102	            if [[ "$PASSED" -eq "$TOTAL" ]]; then
   103	                CI_GOOD=true
   104	            fi
   105	        fi
   106	    else
   107	        # Fallback: parse text output — conservative: only accept if all lines show pass
   108	        CHECKS_TEXT=$(gh pr checks "$PR_NUMBER" --repo "$REPO" 2>/dev/null || echo "")
   109	        if [[ -n "$CHECKS_TEXT" ]]; then
   110	            if ! echo "$CHECKS_TEXT" | grep -qiE '\bfail|pending|in_progress|queued|cancelled|skipping'; then
   111	                CI_GOOD=true
   112	            fi
   113	        fi
   114	        # Empty or unparseable — conservative: treat as not ready
   115	    fi
   116	}
   117	
   118	# --- Fetch PR metadata (mergeStateStatus + headRefOid) in one compound call ---
   119	refresh_pr_info
   120	

