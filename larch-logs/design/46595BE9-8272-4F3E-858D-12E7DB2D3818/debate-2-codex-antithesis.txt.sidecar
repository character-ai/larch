    42	            exit 2
    43	            ;;
    44	    esac
    45	done
    46	
    47	if [[ -z "$DESIGN_TMPDIR" ]]; then
    48	    larch_err "design-driver.sh: --design-tmpdir is required"
    49	    usage
    50	    exit 2
    51	fi
