    89	ensure_ledger() {
    90	    local ledger="$1"
    91	    local parent
    92	    # Reject symlinks before any write. The path validator canonicalizes only
    93	    # the parent directory; if `$ledger` itself is a symlink, every `printf >>`
    94	    # and `chmod` follows the link target — which can be outside the allowed
    95	    # containment roots. Closes review FINDING_13.
    96	    if [[ -L "$ledger" ]]; then
    97	        warn "ledger is a symlink, refusing to write: $ledger"
    98	        return 1
    99	    fi
   100	    parent=$(dirname "$ledger")
   101	    mkdir -p "$parent" 2>/dev/null || return 1
   102	    if [[ ! -e "$ledger" ]]; then
   103	        : > "$ledger" || return 1
   104	    elif [[ ! -f "$ledger" ]]; then
   105	        # Existing path is not a regular file (could be a directory, fifo,
   106	        # device, etc). Refuse to follow.
   107	        warn "ledger exists but is not a regular file: $ledger"
   108	        return 1
   109	    fi
   110	    chmod 600 "$ledger" 2>/dev/null || true
   111	}
   112	
   113	append_tsv_line() {
   114	    local ledger="$1"
   115	    local row="$2"
   116	    local lock="${ledger}.lock"
   117	    ensure_ledger "$ledger" || return 1
   118	    if [[ "${LARCH_TEST_FORCE_NO_FLOCK:-}" != "1" ]] && command -v flock >/dev/null 2>&1; then
   119	        if ( flock -w 5 9 && printf '%s\n' "$row" >> "$ledger" ) 9>"$lock"; then
   120	            chmod 600 "$ledger" 2>/dev/null || true
     1	#!/usr/bin/env bash
     2	# cleanup-tmpdir.sh — Safely remove a session temp directory.
     3	#
     4	# Validates that the path is non-empty and under a larch session tmp root
     5	# before running rm -rf. This prevents accidental deletion of non-temp
     6	# directories if the caller passes an empty or wrong path.
     7	#
     8	# Usage:
     9	#   cleanup-tmpdir.sh --dir <path>
    10	#
    11	# Arguments:
    12	#   --dir — Path to the temp directory to remove
    13	#
    14	# Exit codes:
    15	#   0 — directory removed (or already absent)
    16	#   1 — validation failed (path empty, not under /tmp/, or argument error)
    17	
    18	set -euo pipefail
    19	
    20	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
