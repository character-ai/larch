    27	cache_sessions_root() {
    28	    printf '%s/larch/sessions' "${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}"
    29	}
    30	
    31	is_allowed_tmpdir() {
    32	    local dir=$1
    33	    local cache_root
    34	    cache_root=$(cache_sessions_root)
    35	    case "$dir" in
    36	        /tmp/*|/private/tmp/*|/var/folders/*|/private/var/folders/*) return 0 ;;
    37	        "$cache_root"/*) return 0 ;;
    38	        *) return 1 ;;
    39	    esac
    40	}
    41	
    42	DIR=""
    43	while [[ $# -gt 0 ]]; do
    44	    case "$1" in
    45	        --dir) DIR="${2:?--dir requires a value}"; shift 2 ;;
    46	        --help) usage; exit 0 ;;
    47	        -*) larch_err "Unknown option: $1"; usage; exit 1 ;;
    48	        *) DIR="$1"; shift ;;
    49	    esac
    50	done
    51	
    52	if [[ -z "$DIR" ]]; then
    53	    larch_err "ERROR: --dir is required and must be non-empty"
    54	    exit 1
    55	fi
    56	
    57	# Validate path is under an accepted larch temp root.
    58	if ! is_allowed_tmpdir "$DIR"; then
    59	    larch_err "ERROR: --dir must be under /tmp/, /private/tmp/, /var/folders/, or $(cache_sessions_root)/ (got: $DIR)"
    60	    exit 1
    61	fi
    62	
    63	AUDIT_LOG="${TMPDIR:-/tmp}/larch-cleanup-audit.log"
    64	AUDIT_TS=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "?")
    65	AUDIT_PARENT=$(ps -o comm= -p "$PPID" 2>/dev/null | tr -d '\n' || true)
    66	AUDIT_PARENT="${AUDIT_PARENT//[[:space:]]/_}"
    67	: "${AUDIT_PARENT:=?}"
    68	{ printf '%s pid=%s ppid=%s parent=%s dir=%s\n' "$AUDIT_TS" "$$" "$PPID" "$AUDIT_PARENT" "$DIR" >> "$AUDIT_LOG"; } 2>/dev/null || true
    69	
    70	rm -rf "$DIR"
     1	#!/usr/bin/env bash
     2	# plan-block-write.sh — replace or append larch:plan marker block in issue body.
     3	#
     4	# Usage: plan-block-write.sh --issue <N> --content-file <path> [--repo OWNER/REPO]
     5	#
     6	# Stdout: WRITTEN=, MODE=, MARKERS_PRESENT=, BODY_BYTES=.
     7	# Malformed body: MALFORMED=…, exit 1. gh failure: FAILED=true ERROR=…, exit 2.
     8	# Redaction failure: FAILED=true ERROR=…, exit 3.
     9	
    10	set -euo pipefail
    11	
    12	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    13	# shellcheck source=scripts/lib-quiet.sh
    14	source "$SCRIPT_DIR/lib-quiet.sh"
    15	larch_quiet_init
    16	
    17	REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
    18	REDACT_HELPER="$REPO_ROOT/scripts/redact-secrets.sh"
    19	
    20	MARK_START='^[[:space:]]*<!--[[:space:]]+larch:plan:start[[:space:]]+-->[[:space:]]*$'
    21	MARK_END='^[[:space:]]*<!--[[:space:]]+larch:plan:end[[:space:]]+-->[[:space:]]*$'
    22	CANON_START='<!-- larch:plan:start -->'
    23	CANON_END='<!-- larch:plan:end -->'
    24	
    25	usage() {
    26	    while IFS= read -r line; do larch_err "$line"; done <<'USAGE'
    27	Usage: plan-block-write.sh --issue <N> --content-file <path> [--repo OWNER/REPO]
    28	USAGE
    29	}
    30	
    31	resolve_repo() {
    32	    local r
    33	    if [ -n "${1:-}" ]; then
    34	        printf '%s' "$1"
    35	        return 0
    36	    fi
    37	    r=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null) || r=""
    38	    if [ -z "$r" ]; then
    39	        emit_kv FAILED "true"
    40	        emit_kv ERROR "could not determine repo"
    41	        exit 2
    42	    fi
    43	    printf '%s' "$r"
    44	}
    45	
    46	redact_gh_error() {
    47	    local err_text="$1" redacted status=0
    48	    if [ ! -x "$REDACT_HELPER" ]; then
    49	        printf '%s' 'gh stderr redaction unavailable'
    50	        return 0
    51	    fi
    52	    redacted=$(printf '%s' "$err_text" | "$REDACT_HELPER") || status=$?
    53	    if [ "$status" -ne 0 ]; then
    54	        printf '%s' 'gh stderr redaction failed'
    55	        return 0
    56	    fi
    57	    case "$redacted" in
    58	        *'[content truncated'*)
    59	            printf '%s' 'gh stderr redaction unavailable'
    60	            return 0
    61	            ;;
    62	    esac
    63	    printf '%s' "$redacted" | tr '\n' ' ' | head -c 500
    64	}
    65	
    66	emit_gh_failure() {
    67	    local flat
    68	    flat=$(redact_gh_error "$1")
    69	    emit_kv FAILED "true"
    70	    emit_kv ERROR "$flat"
    71	    exit 2
    72	}
    73	
    74	emit_redaction_failure() {
    75	    emit_kv FAILED "true"
    76	    emit_kv ERROR "redaction: helper failed or not executable"
    77	    exit 3
    78	}
    79	
    80	# Sets: PB_CLASSIFY (absent|present), PB_START_LINE, PB_END_LINE; or emits MALFORMED and exits 1.

