/bin/bash -lc "sed -n '180,300p' skills/design/SKILL.md" in <OPERATOR_REPO_PATH>
exec
/bin/bash -lc "rg -n \"RUN_ID|run-id|uuid|session-id|LARCH_RUN_ID|DESIGN_RUN\" skills/design scripts -g '*.md' -g '*.sh'" in <OPERATOR_REPO_PATH>
exec
/bin/bash -lc "rg -n \"create-pr\\.sh|gh pr merge|git push|delete.*branch|--delete|push origin\" scripts skills -g '*.sh' -g '*.md'" in <OPERATOR_REPO_PATH>
