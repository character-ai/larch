     1	#!/usr/bin/env bash
     2	# redact-secrets.sh — Deterministic defense-in-depth secret scrubber.
     3	#
     4	# Reads arbitrary text on stdin, applies a fixed set of regex replacements,
     5	# and writes the redacted text to stdout. Intended as the outbound choke
     6	# point for content that /issue's create-one.sh publishes as a public
     7	# GitHub issue title or body, complementing prompt-level sanitization in
     8	# skills/implement/SKILL.md and skills/issue/SKILL.md. See SECURITY.md
     9	# ("Untrusted GitHub Issue Content") for the dual-layer trust model.
    10	#
    11	# Covered families (each replaced with <REDACTED-TOKEN> unless noted):
    12	#   - Anthropic / OpenAI sk-* and sk-ant-* keys
    13	#   - GitHub PATs and fine-grained tokens: ghp_, gho_, ghu_, ghs_, ghr_, github_pat_
    14	#   - AWS long-term access key IDs (AKIA[0-9A-Z]{16})
    15	#   - Generic JWT (eyJ…header.payload.signature)
    16	#   - PEM-encoded private key blocks → <REDACTED-PRIVATE-KEY> (multi-line,
    17	#     tolerates leading whitespace and markdown blockquote prefixes on the
    18	#     BEGIN/END markers). If a BEGIN marker appears without a matching END
    19	#     before EOF, the tail of the body is dropped (fail-closed) and a
    20	#     visible `[content truncated — unterminated PEM block…]` marker is
    21	#     emitted on stdout plus a WARN line on stderr.
    22	#
    23	# Explicit non-coverage (not matched; operators must treat this as partial
    24	# defense-in-depth, not comprehensive secret detection):
    25	#   - AWS STS temporary credentials (ASIA* prefix)
    26	#   - Payment-provider live keys (Stripe, Square, etc.)
    27	#   - Opaque bearer tokens without a distinctive prefix
    28	#   - Database connection strings, private hostnames, PII
    29	#
    30	# Idempotence: placeholders (<REDACTED-TOKEN>, <REDACTED-PRIVATE-KEY>) are
    31	# crafted so no covered pattern matches within them; re-running the filter
    32	# on already-redacted output is a no-op.
    33	#
    34	# Portability: uses `sed -E` (BSD and GNU) and `awk` (POSIX). Does NOT
    35	# depend on perl or GNU-specific sed features.
    36	#
    37	# Usage:
    38	#   printf '%s' "$TEXT" | redact-secrets.sh
    39	#   cat body.txt | redact-secrets.sh > redacted.txt
    40	#
    41	# Exit codes:
    42	#   0 — success
    43	#   non-zero — sed or awk failed (propagated via pipefail)
    44	
    45	set -euo pipefail
    46	
    47	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    48	LARCH_QUIET_DISABLE=1
    49	export LARCH_QUIET_DISABLE
    50	# shellcheck source=scripts/lib-quiet.sh
    51	source "$SCRIPT_DIR/lib-quiet.sh"
    52	larch_quiet_init
    53	
    54	# Single sed -E invocation collapsing all line-local families into one pass.
    55	# Patterns are byte-for-byte ports of the vetted regexes from the deleted
    56	# scripts/create-oos-issues.sh (see commit 9cb59f5). The character classes
    57	# use [A-Za-z0-9_-] rather than \w so the script runs on BSD sed without
    58	# GNU-only extensions.
    59	#
    60	# Then awk handles the multi-line PEM case that sed cannot: awk walks the
    61	# stream line-by-line, and when it sees a BEGIN marker it swallows lines
    62	# until the matching END marker, emitting a single placeholder for the
    63	# whole block. Non-PEM lines pass through unchanged.
    64	sed -E \
    65	    -e 's/sk-(ant-)?[A-Za-z0-9_-]{20,}/<REDACTED-TOKEN>/g' \
    66	    -e 's/(ghp|gho|ghu|ghs|ghr|github_pat)_[A-Za-z0-9_]{20,}/<REDACTED-TOKEN>/g' \
    67	    -e 's/AKIA[0-9A-Z]{16}/<REDACTED-TOKEN>/g' \
    68	    -e 's/eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}/<REDACTED-TOKEN>/g' \
    69	    | awk '
    70	        # Allow leading whitespace and markdown blockquote prefixes (> ) so
    71	        # PEM blocks wrapped in `    -----BEGIN ...` (code-block indent) or
    72	        # `> -----BEGIN ...` (blockquote) are still matched. The prefix
    73	        # characters are dropped from the emitted placeholder.
    74	        /^[[:space:]>]*-----BEGIN [A-Z ]*PRIVATE KEY-----/ {
    75	            print "<REDACTED-PRIVATE-KEY>"
    76	            in_pem = 1
    77	            next
    78	        }
    79	        in_pem {
    80	            if (/^[[:space:]>]*-----END [A-Z ]*PRIVATE KEY-----/) {
    81	                in_pem = 0
    82	            }
    83	            next
    84	        }
    85	        { print }
    86	        # Fail-closed: on EOF while still inside a PEM block (a BEGIN line
    87	        # without matching END), the tail after BEGIN has already been
    88	        # swallowed to avoid leaking key material. Emit a visible marker so
    89	        # the truncation is not silent and issue authors notice the body is
    90	        # incomplete. Also signal to stderr for log visibility.
    91	        END {
    92	            if (in_pem) {
    93	                print "[content truncated — unterminated PEM block; tail of body dropped for safety]"
    94	                print "WARN: redact-secrets.sh: unterminated PEM block; body tail dropped" > "/dev/stderr"
    95	            }
    96	        }
    97	    '

