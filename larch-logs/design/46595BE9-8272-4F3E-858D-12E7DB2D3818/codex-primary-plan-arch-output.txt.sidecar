   538	            ERR_CONTENT=$(cat "$ERR_TMP")
   539	            emit_gh_failure "gh issue edit failed: $ERR_CONTENT"
   540	        fi
   541	        emit_kv RENAMED "true"
   542	        emit_kv NEW_TITLE "$NEW_TITLE"
   543	        if [[ "$ROUND_TRIP_FLAG_PASSED" == "true" ]]; then
   544	            emit_kv ROUND_TRIP_APPLIED "$ROUND_TRIP_APPLIED"
   545	        fi
   546	        exit 0
   547	        ;;
