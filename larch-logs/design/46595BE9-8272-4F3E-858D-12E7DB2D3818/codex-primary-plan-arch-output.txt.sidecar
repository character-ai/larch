   101	stage_round_artifact() {
   102	    local input="$1"
   103	    local output="$2"
   104	    local name trim_tmp
   105	    name="$(basename "$input")"
   106	    trim_tmp="$(mktemp "${TMPDIR:-/tmp}/larch-log-round-trim.XXXXXX")" || larch_log_fail 2 "cannot create round trim temp"
   107	    (
   108	        trap 'rm -f "$trim_tmp"' EXIT
   109	        case "$name" in
