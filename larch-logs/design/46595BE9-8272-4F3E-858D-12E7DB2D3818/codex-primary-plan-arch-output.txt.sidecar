     2	# larch-log-flush.sh — best-effort explicit flush for active /implement runs.
     3	
     4	set -euo pipefail
     5	
     6	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
