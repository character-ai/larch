   218	        if [ -f "$path" ]; then
   219	            larch_log_emit_success "$path" false true
   220	            exit 0
   221	        fi
   222	        write_manifest_file "$path" "$PARENT_SKILL" "$ISSUE"
   223	        larch_log_emit_success "$path" true false
   224	        ;;
   225	
   226	    write)
   227	        LOG_ROOT=""; SKILL=""; RUN_ID=""; BATCH=""; INPUT_FILE=""
   228	        while [ $# -gt 0 ]; do
   229	            case "$1" in
   230	                --log-root) LOG_ROOT="${2:?--log-root requires a value}"; shift 2 ;;
   231	                --skill) SKILL="${2:?--skill requires a value}"; shift 2 ;;
   232	                --run-id) RUN_ID="${2:?--run-id requires a value}"; shift 2 ;;
   233	                --batch) BATCH="${2:?--batch requires a value}"; shift 2 ;;
   234	                --input-file) INPUT_FILE="${2:?--input-file requires a value}"; shift 2 ;;
   235	                --commit) shift ;;
   236	                *) usage; larch_log_fail 1 "unknown option for write: $1" ;;
   237	            esac
   238	        done
   239	        require_log_root
   240	        require_common
   241	        [ -n "$BATCH" ] || larch_log_fail 1 "--batch is required"
   242	        [ -f "$INPUT_FILE" ] || larch_log_fail 1 "input file not found: $INPUT_FILE"
   243	        mode="$(larch_log_batch_mode "$BATCH")" || larch_log_fail 1 "unknown batch: $BATCH"
   244	        [ "$mode" = "replace" ] || larch_log_fail 1 "batch $BATCH is append-only; use append"
   245	        path="$(larch_log_batch_path "$SKILL" "$RUN_ID" "$BATCH")"
   246	        tmp="$(mktemp "${TMPDIR:-/tmp}/larch-log-write.XXXXXX")" || larch_log_fail 2 "cannot create temp payload"
