     1	#!/usr/bin/env bash
     2	# merge-pr.sh - Squash-merge a PR, trying --admin first after safety gates.
     3	#
     4	# Checks whether the branch is behind main and whether CI is ready before
     5	# any merge attempt. If CI is confirmed passing and the branch is
     6	# up-to-date, tries `gh pr merge --squash --admin` first, then falls back
     7	# to a plain squash merge if the privileged attempt fails. When
     8	# --no-admin-fallback is set, skips the privileged attempt and tries only
     9	# the plain squash merge; if that fails, returns MERGE_RESULT=policy_denied.
    10	#
    11	# CRITICAL: The --admin flag overrides ALL branch protection rules
    12	# including review requirements. It is ONLY used after confirming:
    13	#   1. All CI checks are passing (bucket == "pass" for every check)
    14	#   2. The branch is up-to-date with main and in an admin-eligible state
    15	# This is the canonical --admin implementation.
    16	# See skills/implement/SKILL.md Step 12b for usage documentation.
    17	#
    18	# Usage:
    19	#   merge-pr.sh --pr NUMBER --repo OWNER/REPO [--no-admin-fallback]
    20	#
    21	# --no-admin-fallback: opts out of the --admin-first attempt. When set,
    22	#   the script reaches the same admin-eligible gate (CI good + branch
    23	#   fresh) but invokes only `gh pr merge --squash`; if that plain merge
    24	#   fails, it emits MERGE_RESULT=policy_denied. This applies to ALL
    25	#   admin-eligible mergeStateStatus values (CLEAN, UNSTABLE, HAS_HOOKS,
    26	#   BLOCKED) — not just review-required denials.
    27	#
    28	# Outputs (key=value to stdout, always emitted via EXIT trap):
    29	#   MERGE_RESULT=merged|admin_merged|main_advanced|ci_not_ready|version_already_published|admin_failed|policy_denied|error
    30	#   ERROR=<message>    (empty string when no error)
    31	#
    32	# version_already_published fires only after the PR-head-OID precondition
    33	# succeeds, the branch range contains a literal "Bump version to X.Y.Z" commit,
    34	# and origin/main's published plugin.json version matches that local bump.
    35	#
    36	# Exit codes:
    37	#   0 — always (result communicated via MERGE_RESULT)
    38	#   1 — usage/argument error (no output emitted)
    39	
    40	set -uo pipefail
    41	
    42	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    43	# shellcheck source=scripts/lib-quiet.sh
    44	source "$SCRIPT_DIR/lib-quiet.sh"
    45	larch_quiet_init
    46	
    47	usage() { larch_err "Usage: merge-pr.sh --pr NUMBER --repo OWNER/REPO [--no-admin-fallback]"; }
    48	
    49	# --- Parse arguments (before installing EXIT trap) ---
    50	PR_NUMBER=""
    51	REPO=""
    52	NO_ADMIN_FALLBACK=false
    53	while [[ $# -gt 0 ]]; do
    54	    case "$1" in
    55	        --pr) PR_NUMBER="${2:?--pr requires a value}"; shift 2 ;;
    56	        --repo) REPO="${2:?--repo requires a value}"; shift 2 ;;
    57	        --no-admin-fallback) NO_ADMIN_FALLBACK=true; shift ;;
    58	        --help) usage; exit 0 ;;
    59	        *) larch_err "Unknown option: $1"; usage; exit 1 ;;
    60	    esac
    61	done
    62	
    63	if [[ -z "$PR_NUMBER" ]] || [[ -z "$REPO" ]]; then
    64	    larch_err "ERROR: --pr and --repo are required"
    65	    usage; exit 1
    66	fi
    67	
    68	# --- Output defaults (emitted via trap on any exit after validation) ---
    69	MERGE_RESULT="error"
    70	ERROR="merge-pr.sh exited unexpectedly"
    71	
    72	# shellcheck disable=SC2329,SC2317  # invoked via EXIT trap
    73	emit_output() {
    74	    emit_kv MERGE_RESULT "$MERGE_RESULT"
    75	    emit_kv ERROR "$ERROR"
    76	}
    77	trap 'emit_output' EXIT
    78	
    79	refresh_pr_info() {
    80	    PR_INFO=$(gh pr view "$PR_NUMBER" --repo "$REPO" --json mergeStateStatus,headRefOid 2>/dev/null || echo "")
    81	    MERGE_STATE=$(echo "$PR_INFO" | jq -r '.mergeStateStatus // ""' 2>/dev/null || echo "")
    82	    PR_HEAD_OID=$(echo "$PR_INFO" | jq -r '.headRefOid // ""' 2>/dev/null || echo "")
    83	}
    84	
    85	refresh_ci_state() {
    86	    # Use gh pr checks --json with bucket field (consistent with ci-status.sh)
    87	    CHECKS_JSON=$(gh pr checks "$PR_NUMBER" --repo "$REPO" --json name,state,bucket,link 2>/dev/null || echo "")
    88	
    89	    CI_GOOD=false
    90	    if [[ -n "$CHECKS_JSON" ]] && [[ "$CHECKS_JSON" != "null" ]] \
    91	        && echo "$CHECKS_JSON" | jq -e 'type == "array"' >/dev/null 2>&1; then
    92	        TOTAL=$(echo "$CHECKS_JSON" | jq 'length' 2>/dev/null || echo "0")
    93	
    94	        if [[ "$TOTAL" -eq 0 ]]; then
    95	            # Zero checks — conservative: treat as not ready
    96	            CI_GOOD=false
    97	        else
    98	            # Require every check to have bucket == "pass" (not just absence of fail/pending).
    99	            # This rejects cancelled, skipping, or any other non-pass bucket.
   100	            PASSED=$(echo "$CHECKS_JSON" | jq '[.[] | select(.bucket == "pass")] | length' 2>/dev/null || echo "0")
   101	
   102	            if [[ "$PASSED" -eq "$TOTAL" ]]; then
   103	                CI_GOOD=true
   104	            fi
   105	        fi
   106	    else
   107	        # Fallback: parse text output — conservative: only accept if all lines show pass
   108	        CHECKS_TEXT=$(gh pr checks "$PR_NUMBER" --repo "$REPO" 2>/dev/null || echo "")
   109	        if [[ -n "$CHECKS_TEXT" ]]; then
   110	            if ! echo "$CHECKS_TEXT" | grep -qiE '\bfail|pending|in_progress|queued|cancelled|skipping'; then
   111	                CI_GOOD=true
   112	            fi
   113	        fi
   114	        # Empty or unparseable — conservative: treat as not ready
   115	    fi
   116	}
   117	
   118	# --- Fetch PR metadata (mergeStateStatus + headRefOid) in one compound call ---
   119	refresh_pr_info
   120	
   121	if [[ "$MERGE_STATE" == "BEHIND" ]]; then
   122	    MERGE_RESULT="main_advanced"
   123	    ERROR=""
   124	    exit 0
   125	fi
   126	
   127	# Empty or UNKNOWN mergeStateStatus = could not determine merge state
   128	# (gh API/network failure on the empty path; GitHub itself unsure on UNKNOWN).
   129	# Routing through the admin-eligible gate below would mis-emit main_advanced
   130	# with a misleading "Branch mergeStateStatus is " (empty trailing) error and
   131	# nudge callers toward a useless rebase. Treat as the existing `error` outcome
   132	# so the orchestrator bails to its error-handling path.
   133	if [[ -z "$MERGE_STATE" ]] || [[ "$MERGE_STATE" == "UNKNOWN" ]]; then
   134	    MERGE_RESULT="error"
   135	    ERROR="could not read mergeStateStatus from gh pr view --json mergeStateStatus,headRefOid (state=\"$MERGE_STATE\")"
   136	    exit 0
   137	fi
   138	
   139	# --- Re-verify CI before attempting --admin ---
   140	refresh_ci_state
   141	
   142	if [[ "$CI_GOOD" != "true" ]]; then
   143	    MERGE_RESULT="ci_not_ready"
   144	    ERROR="CI checks are not all passing"
   145	    exit 0
   146	fi
   147	
   148	# CLEAN = mergeable normally; UNSTABLE = CI passed but review not approved;
   149	# BLOCKED = review/policy block (--admin handles this); HAS_HOOKS = has pre-receive hooks.
   150	# BEHIND and empty/UNKNOWN are already handled above; remaining non-admin-eligible
   151	# states (e.g. DIRTY, DRAFT, or any future GitHub-added value) → main_advanced
   152	# to retry after updating the branch.
   153	if [[ "$MERGE_STATE" != "CLEAN" ]] && [[ "$MERGE_STATE" != "UNSTABLE" ]] && [[ "$MERGE_STATE" != "HAS_HOOKS" ]] && [[ "$MERGE_STATE" != "BLOCKED" ]]; then
   154	    MERGE_RESULT="main_advanced"
   155	    ERROR="Branch mergeStateStatus is $MERGE_STATE"
   156	    exit 0
   157	fi
   158	
   159	# --- Same-version bump race gate ---
   160	if [[ -z "$PR_HEAD_OID" ]]; then
   161	    MERGE_RESULT="error"
   162	    ERROR="could not resolve PR head OID via gh pr view"
   163	    exit 0
   164	fi
   165	
   166	flush_recovery_is_logs_only() {
   167	    local base_oid="$1"
   168	    local diff_paths=""
   169	
   170	    diff_paths=$(git diff --name-only "${base_oid}..HEAD" 2>/dev/null || echo "")
   171	    [[ -n "$diff_paths" ]] || return 1
   172	    ! printf '%s\n' "$diff_paths" | grep -qv '^larch-logs/' 2>/dev/null
   173	}
   174	
   175	LOCAL_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")
   176	if [[ -z "$LOCAL_HEAD" ]] || [[ "$LOCAL_HEAD" != "$PR_HEAD_OID" ]]; then
   177	    # Check whether local HEAD is ahead of the PR head exclusively by
   178	    # larch-log flush commits. That pattern arises when larch-log-flush.sh
   179	    # tail calls fire after gh pr create, advancing local HEAD beyond the
   180	    # OID GitHub recorded for the PR.
   181	    _flush_recoverable=false
   182	    if [[ -n "$LOCAL_HEAD" ]]; then
   183	        FLUSH_AHEAD=$(git log --format='%s' "${PR_HEAD_OID}..HEAD" 2>/dev/null || echo "")
   184	        FLUSH_COUNT=$(printf '%s\n' "$FLUSH_AHEAD" | grep -c . 2>/dev/null || true)
   185	        if [[ "$FLUSH_COUNT" -gt 0 ]] && [[ "$FLUSH_COUNT" -le 5 ]] \
   186	            && ! printf '%s\n' "$FLUSH_AHEAD" | grep -qv '^chore(larch-logs): flush ' \
   187	            && flush_recovery_is_logs_only "$PR_HEAD_OID" \
   188	            && git merge-base --is-ancestor "$PR_HEAD_OID" HEAD 2>/dev/null; then
   189	            _flush_recoverable=true
   190	        fi
   191	    fi
   192	    if [[ "$_flush_recoverable" == "true" ]]; then
   193	        FORCE_OUT=$("$SCRIPT_DIR/git-force-push.sh" --expected-remote-oid "$PR_HEAD_OID" 2>&1 || true)
   194	        PUSHED=$(printf '%s\n' "$FORCE_OUT" | awk -F= '/^PUSHED=/ { print $2 }')
   195	        FORCE_STATUS=$(printf '%s\n' "$FORCE_OUT" | awk -F= '/^STATUS=/ { print $2 }')
   196	        if [[ "$PUSHED" != "true" ]]; then
   197	            MERGE_RESULT="error"
   198	            FORCE_OUT_ONE_LINE=$(printf '%s' "$FORCE_OUT" | tr '\n' ' ')
   199	            ERROR="local HEAD ($LOCAL_HEAD) is ahead of PR head OID ($PR_HEAD_OID) by flush commits only; force-push failed (status=${FORCE_STATUS:-unknown}; output=${FORCE_OUT_ONE_LINE})"
   200	            exit 0
   201	        fi
   202	        # Re-read PR metadata after the force-push advanced the remote HEAD.
   203	        refresh_pr_info
   204	        LOCAL_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")
   205	        if [[ -z "$LOCAL_HEAD" ]] || [[ "$LOCAL_HEAD" != "$PR_HEAD_OID" ]]; then
   206	            MERGE_RESULT="error"
   207	            ERROR="local HEAD ($LOCAL_HEAD) does not match PR head OID ($PR_HEAD_OID) after force-push recovery"
   208	            exit 0
   209	        fi
   210	        if [[ "$MERGE_STATE" == "BEHIND" ]]; then
   211	            MERGE_RESULT="main_advanced"
   212	            ERROR=""
   213	            exit 0
   214	        fi
   215	        # GitHub's API often returns UNKNOWN immediately after a push due to
   216	        # propagation delay (#2342). Retry briefly before treating as a hard
   217	        # error so transient post-push UNKNOWN states don't stall the merge.
   218	        if [[ -z "$MERGE_STATE" ]] || [[ "$MERGE_STATE" == "UNKNOWN" ]]; then
   219	            for _retry in 1 2 3; do
   220	                sleep 5
   221	                refresh_pr_info
   222	                if [[ -n "$MERGE_STATE" ]] && [[ "$MERGE_STATE" != "UNKNOWN" ]]; then
   223	                    break
   224	                fi
   225	            done
   226	        fi
   227	        if [[ -z "$MERGE_STATE" ]] || [[ "$MERGE_STATE" == "UNKNOWN" ]]; then
   228	            MERGE_RESULT="error"
   229	            ERROR="mergeStateStatus still UNKNOWN after 3 retries post-force-push (state=\"$MERGE_STATE\")"
   230	            exit 0
   231	        fi
   232	        refresh_ci_state
   233	        if [[ "$CI_GOOD" != "true" ]]; then
   234	            MERGE_RESULT="ci_not_ready"
   235	            ERROR="CI checks are not all passing after force-push recovery"
   236	            exit 0
   237	        fi
   238	        if [[ "$MERGE_STATE" != "CLEAN" ]] && [[ "$MERGE_STATE" != "UNSTABLE" ]] && [[ "$MERGE_STATE" != "HAS_HOOKS" ]] && [[ "$MERGE_STATE" != "BLOCKED" ]]; then
   239	            MERGE_RESULT="main_advanced"
   240	            ERROR="Branch mergeStateStatus is $MERGE_STATE after force-push recovery"
   241	            exit 0
   242	        fi
   243	    else
   244	        MERGE_RESULT="error"
   245	        ERROR="local HEAD ($LOCAL_HEAD) does not match PR head OID ($PR_HEAD_OID); refusing to evaluate same-version gate"
   246	        exit 0
   247	    fi
   248	fi
   249	
   250	if ! git fetch origin main --quiet 2>/dev/null; then
   251	    MERGE_RESULT="error"
   252	    ERROR="git fetch origin main failed; cannot verify same-version race"
   253	    exit 0
   254	fi
   255	
   256	BUMP_SUBJECT=$(git log --format='%s' origin/main..HEAD 2>/dev/null | grep -E '^Bump version to [0-9]+\.[0-9]+\.[0-9]+$' | head -n1 || true)
   257	if [[ -n "$BUMP_SUBJECT" ]]; then
   258	    [[ "$BUMP_SUBJECT" =~ ^Bump\ version\ to\ ([0-9]+\.[0-9]+\.[0-9]+)$ ]]
   259	    LOCAL_VERSION="${BASH_REMATCH[1]}"
   260	

