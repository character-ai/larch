   324	                ERR_CONTENT=$(cat "$ERR_TMP")
   325	                emit_gh_failure "gh issue create did not emit a URL (stderr: $ERR_CONTENT)"
   326	            fi
   327	            ISSUE_NUM=$(echo "$URL_LINE" | grep -oE '[0-9]+$')
   328	            emit_kv ISSUE_NUMBER "$ISSUE_NUM"
   329	            emit_kv ISSUE_URL "$URL_LINE"
   330	            exit 0
   331	        else
   332	            ERR_CONTENT=$(cat "$ERR_TMP")
   333	            emit_gh_failure "$ERR_CONTENT"
   334	        fi
   335	        ;;
