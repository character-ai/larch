     1	#!/usr/bin/env bash
     2	# lib-larch-log.sh — shared helpers for scripts/larch-log.sh.
     3	
     4	set -euo pipefail
     5	
     6	LARCH_LOG_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
     7	# Resolve repo root from caller's CWD (consumer repo) so larch-logs land
     8	# in the project being worked on, not the plugin install cache. Remains empty
     9	# outside a git worktree.
    10	LARCH_LOG_REPO_ROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" || true
    11	
    12	# shellcheck source=scripts/larch-log-batches.sh
    13	# shellcheck disable=SC1091
    14	source "$LARCH_LOG_LIB_DIR/larch-log-batches.sh"
    15	
    16	larch_log_fail() {
    17	    local code="$1"
    18	    local message="$2"
    19	    echo "LOG_WRITTEN=false"
    20	    echo "LOG_PATH="
    21	    echo "BYTES=0"
    22	    echo "SHA256="
    23	    echo "COMMIT_SHA="
    24	    echo "UNCHANGED=false"
    25	    echo "ERROR=$message"
    26	    exit "$code"
    27	}
    28	
    29	larch_log_validate_slug() {
    30	    local kind="$1"
    31	    local value="$2"
    32	    case "$value" in
    33	        ""|*[!A-Za-z0-9._-]*|.*|*..*|*/*|*\\*) larch_log_fail 1 "invalid $kind: $value" ;;
    34	    esac
    35	}
    36	
    37	larch_log_root() {
    38	    if [ -n "${LARCH_LOG_ROOT:-}" ]; then
    39	        printf '%s\n' "$LARCH_LOG_ROOT"
    40	    else
    41	        larch_log_fail 1 "LARCH_LOG_ROOT is not set; pass --log-root to larch-log.sh (or export LARCH_LOG_ROOT for test isolation)"
    42	    fi
    43	}
    44	
    45	larch_log_repo_run_dir() {
    46	    local skill="$1" run_id="$2"
    47	    printf '%s/larch-logs/%s/%s\n' "$LARCH_LOG_REPO_ROOT" "$skill" "$run_id"
    48	}
    49	
    50	larch_log_run_dir() {
    51	    local skill="$1"
    52	    local run_id="$2"
    53	    printf '%s/%s/%s\n' "$(larch_log_root)" "$skill" "$run_id"
    54	}
    55	
    56	larch_log_batch_path() {
    57	    local skill="$1"
    58	    local run_id="$2"
    59	    local batch="$3"
    60	    local ext
    61	    ext="$(larch_log_batch_extension "$batch")" || larch_log_fail 1 "unknown batch: $batch"
    62	    printf '%s/%s%s\n' "$(larch_log_run_dir "$skill" "$run_id")" "$batch" "$ext"
    63	}
    64	
    65	larch_log_sha256() {
    66	    local file="$1"
    67	    if command -v shasum >/dev/null 2>&1; then
    68	        LC_ALL=C shasum -a 256 "$file" | awk '{ print $1 }'
    69	    else
    70	        LC_ALL=C sha256sum "$file" | awk '{ print $1 }'
    71	    fi
    72	}
    73	
    74	larch_log_bytes() {
    75	    wc -c < "$1" | tr -d ' '
    76	}
    77	
    78	larch_log_redact_file() {
    79	    local input="$1"
    80	    local output="$2"
    81	    local redact_tmp="$LARCH_LOG_LIB_DIR/redact-tmpdir-paths.sh"
    82	    local redact_secrets="$LARCH_LOG_LIB_DIR/redact-secrets.sh"
    83	    [ -x "$redact_tmp" ] || larch_log_fail 2 "redaction helper missing: $redact_tmp"
    84	    [ -x "$redact_secrets" ] || larch_log_fail 2 "redaction helper missing: $redact_secrets"
    85	    "$redact_tmp" < "$input" | "$redact_secrets" > "$output" || larch_log_fail 2 "redaction failed"
    86	}
    87	
    88	larch_log_validate_batch_payload() {
    89	    local batch="$1"
    90	    local file="$2"
    91	    local sanitizer impl_tmp
    92	    sanitizer="$(larch_log_batch_sanitizer "$batch")" || larch_log_fail 1 "unknown batch: $batch"
    93	    case "$sanitizer" in
    94	        none) ;;
    95	        plan-goals)
    96	            impl_tmp="$(mktemp "${TMPDIR:-/tmp}/larch-log-plan-goals.XXXXXX")" \
    97	                || larch_log_fail 2 "cannot create plan-goals sanitizer temp"
    98	            if ! awk '
    99	                $0 == "## Implementation Plan" {
   100	                    if (!saw) in_section = 1
   101	                    saw = 1
   102	                    next
   103	                }
   104	                in_section {
   105	                    lines[++count] = $0
   106	                    if ($0 == "## Test plan") last_test_plan = count
   107	                }
   108	                END {
   109	                    if (!saw) exit 3
   110	                    limit = count
   111	                    if (last_test_plan > 0) limit = last_test_plan - 1
   112	                    for (i = 1; i <= limit; i++) print lines[i]
   113	                }
   114	            ' "$file" > "$impl_tmp"; then
   115	                rm -f "$impl_tmp"
   116	                larch_log_fail 2 "plan-goals sanitizer rejected: missing Implementation Plan section"
   117	            fi
   118	            if ! awk 'NF { found = 1 } END { exit(found ? 0 : 1) }' "$impl_tmp"; then
   119	                rm -f "$impl_tmp"
   120	                larch_log_fail 2 "plan-goals sanitizer rejected: Implementation Plan body is empty"
   121	            fi
   122	            if awk '
   123	                NF {
   124	                    count++
   125	                    if (count == 1) {
   126	                        line = $0
   127	                        gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
   128	                        first = tolower(line)
   129	                    }
   130	                }
   131	                END {
   132	                    if (first ~ /^(see plan\.txt|see attached|see linked|tbd|todo)\.?$/) exit 0
   133	                    exit 1
   134	                }
   135	            ' "$impl_tmp"; then
   136	                rm -f "$impl_tmp"
   137	                larch_log_fail 2 "plan-goals sanitizer rejected: Implementation Plan body is a pointer-only placeholder"
   138	            fi
   139	            rm -f "$impl_tmp"
   140	            ;;
   141	        mermaid)
   142	            "$LARCH_LOG_LIB_DIR/sanitize-mermaid-fragment.sh" --input "$file" --from-md >/dev/null \
   143	                || larch_log_fail 2 "mermaid sanitizer rejected $batch"
   144	            ;;
   145	        json-lines)
   146	            [ -s "$file" ] || return 0
   147	            while IFS= read -r line || [ -n "$line" ]; do
   148	                [ -z "$line" ] && continue
   149	                printf '%s' "$line" | jq . >/dev/null 2>&1 \
   150	                    || larch_log_fail 2 "json-lines sanitizer rejected $batch: invalid JSON line"
   151	            done < "$file"
   152	            ;;
   153	        json-object)
   154	            jq -e -s 'length == 1 and (.[0] | type == "object")' "$file" >/dev/null 2>&1 \
   155	                || larch_log_fail 2 "json-object sanitizer rejected $batch: expected exactly one top-level JSON object"
   156	            ;;
   157	        *) larch_log_fail 1 "unknown sanitizer for $batch: $sanitizer" ;;
   158	    esac
   159	}
   160	
   161	larch_log_atomic_replace() {
   162	    local src="$1"
   163	    local dest="$2"
   164	    local dir tmp
   165	    dir="$(dirname "$dest")"
   166	    mkdir -p "$dir" || larch_log_fail 2 "cannot create log directory: $dir"
   167	    tmp="$(mktemp "$dir/.tmp.$(basename "$dest").XXXXXX")" || larch_log_fail 2 "cannot create temp file"
   168	    cp "$src" "$tmp" || {
   169	        rm -f "$tmp"
   170	        larch_log_fail 2 "cannot stage log payload"
   171	    }
   172	    mv -f "$tmp" "$dest" || {
   173	        rm -f "$tmp"
   174	        larch_log_fail 2 "cannot publish log payload"
   175	    }
   176	}
   177	
   178	larch_log_emit_success() {
   179	    local path="$1"
   180	    local written="$2"
   181	    local unchanged="$3"
   182	    local commit_sha="${4:-}"
   183	    local bytes sha
   184	    if [ -f "$path" ]; then
   185	        bytes="$(larch_log_bytes "$path")"
   186	        sha="$(larch_log_sha256 "$path")"
   187	    else
   188	        bytes=0
   189	        sha=""
   190	    fi
   191	    echo "LOG_WRITTEN=$written"
   192	    echo "LOG_PATH=$path"
   193	    echo "BYTES=$bytes"
   194	    echo "SHA256=$sha"
   195	    echo "COMMIT_SHA=$commit_sha"
   196	    echo "UNCHANGED=$unchanged"
   197	}

