   204	printf '%s\n' "$PR_OUTPUT" > "$PR_STDOUT_FILE"
   205	
   206	if [[ $PR_EXIT -ne 0 ]]; then
   207	    PR_STDERR=$(cat "$PR_STDERR_FILE" 2>/dev/null || true)
   208	    PR_STDOUT_TAIL=$(tail -10 "$PR_STDOUT_FILE" 2>/dev/null || true)
   209	    if [[ -z "$PR_STDERR" && -z "$PR_STDOUT_TAIL" ]]; then
   210	        larch_err "ERROR: Failed to create PR (exit $PR_EXIT): (no diagnostic captured; gh pr create exited $PR_EXIT with no output. Manual investigation required.) argv: $GH_CREATE_ARGV"
   211	    else
   212	        larch_err "ERROR: Failed to create PR (exit $PR_EXIT): stderr=$PR_STDERR stdout_tail=$PR_STDOUT_TAIL argv=$GH_CREATE_ARGV"
   213	    fi
   214	    exit 2
   215	fi
   216	
   217	# --- Extract PR number and URL ---
   218	# gh pr create outputs the PR URL on success
   219	PR_URL="$PR_OUTPUT"
   220	
   221	# Parse PR number from URL first (avoids extra API call)
   222	# URL format: https://github.com/owner/repo/pull/N
   223	PR_NUMBER=$(echo "$PR_URL" | grep -oE '[0-9]+$' || echo "")
   224	
   225	if [[ -z "$PR_NUMBER" ]]; then
   226	    # Fallback: fetch via gh pr view if URL parsing failed
   227	    PR_NUMBER=$(gh pr view ${GH_REPO_ARGS[@]+"${GH_REPO_ARGS[@]}"} --json number -q '.number' 2>/dev/null || echo "")
   228	fi
   229	
   230	if [[ -z "$PR_NUMBER" ]] || [[ -z "$PR_URL" ]]; then
   231	    larch_err "ERROR: Could not extract PR number/URL from output: $PR_OUTPUT"
   232	    exit 2
   233	fi
   234	
   235	emit_kv PR_NUMBER "$PR_NUMBER"
   236	emit_kv PR_URL "$PR_URL"
   237	emit_kv PR_TITLE "$TITLE"
   238	emit_kv PR_STATUS "created"

