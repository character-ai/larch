   196	cmd="${1:-}"
   197	[ -n "$cmd" ] || { usage; exit 1; }
   198	shift
   199	
   200	case "$cmd" in
   201	    init)
   202	        LOG_ROOT=""; SKILL=""; RUN_ID=""; PARENT_SKILL=""; ISSUE=""
   203	        while [ $# -gt 0 ]; do
   204	            case "$1" in
   205	                --log-root) LOG_ROOT="${2:?--log-root requires a value}"; shift 2 ;;
   206	                --skill) SKILL="${2:?--skill requires a value}"; shift 2 ;;
   207	                --run-id) RUN_ID="${2:?--run-id requires a value}"; shift 2 ;;
   208	                --parent-skill) PARENT_SKILL="${2:?--parent-skill requires a value}"; shift 2 ;;
