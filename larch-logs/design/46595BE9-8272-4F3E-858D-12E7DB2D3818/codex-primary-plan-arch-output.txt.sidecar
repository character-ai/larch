   114	                larch_redact_strip_json_result "$input" "$trim_tmp" || larch_log_fail 2 "cannot trim json sidecar: $input"
   115	                ;;
   116	            *)
   117	                cp "$input" "$trim_tmp" || larch_log_fail 2 "cannot stage round artifact: $input"
   118	                ;;
   119	        esac
   120	        larch_log_redact_file "$trim_tmp" "$output"
   121	    )
   122	}
