   249	        larch_log_validate_batch_payload "$BATCH" "$tmp"
   250	        if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
   251	            larch_log_emit_success "$path" false true
   252	            exit 0
   253	        fi
   254	        larch_log_atomic_replace "$tmp" "$path"
   255	        larch_log_emit_success "$path" true false
   256	        ;;
