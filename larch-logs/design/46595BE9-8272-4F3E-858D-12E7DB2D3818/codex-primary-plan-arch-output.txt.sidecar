   124	current_branch_is_default() {
   125	    local current_branch default_branch
   126	    current_branch="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
   127	    [ -n "$current_branch" ] || return 1
   128	    [ "$current_branch" != "HEAD" ] || return 1
   129	    [ "$current_branch" != "main" ] || return 0
   130	    [ "$current_branch" != "master" ] || return 0
   131	
   132	    default_branch="$(
   133	        git -C "$REPO_ROOT" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
   134	            | sed 's|^refs/remotes/origin/||'
   135	    )" || default_branch=""
   136	    [ -n "$default_branch" ] || return 1
   137	    [ "$current_branch" = "$default_branch" ]
   138	}
