    15	    case "${1:-}" in
    16	        1|true|TRUE|True|yes|YES|Yes|on|ON|On) return 0 ;;
    17	        *) return 1 ;;
    18	    esac
    19	}
    20	
    21	larch_quiet_default_log() {
    22	    local base script tmp
    23	    base="${0##*/}"
    24	    script=${base:-larch-script}
    25	    if [ -n "${IMPLEMENT_TMPDIR:-}" ] && [ -d "$IMPLEMENT_TMPDIR" ]; then
