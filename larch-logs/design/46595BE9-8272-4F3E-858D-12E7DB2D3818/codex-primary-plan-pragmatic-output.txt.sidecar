    30	        tmp="$DESIGN_TMPDIR"
    31	    else
    32	        tmp="${TMPDIR:-/tmp}"
    33	    fi
    34	    printf '%s/larch-quiet-%s-%s.log\n' "$tmp" "$script" "$$"
    35	}
    36	
    37	larch_quiet_init() {
    38	    local log_file log_dir
    39	
    40	    if larch_quiet_truthy "${LARCH_QUIET_DISABLE:-}"; then
    41	        return 0
    42	    fi
    43	    # ACTIVE=1 without LARCH_QUIET_PID is not a bound quiet session (e.g. a
    44	    # stray env export): do not redirect ordinary stdout. A subprocess that
    45	    # inherits a real parent session always has LARCH_QUIET_PID set to the
    46	    # parent's PID (≠ $$), so it still runs full init below.
    47	    if larch_quiet_truthy "${LARCH_QUIET_ACTIVE:-}" && [ -z "${LARCH_QUIET_PID:-}" ]; then
    48	        return 0
    49	    fi
    50	    # Use PID as the idempotency key so subprocess re-initialization is correct.
    51	    # Inheriting LARCH_QUIET_ACTIVE=1 from a parent must NOT skip init in the
    52	    # child: the child's FD1 may differ (command substitution, file redirect),
    53	    # and exec 3>&1 must capture the child's current FD1 so emit/emit_kv route
    54	    # contract output to the child's immediate caller, not the grandparent.
    55	    if [ "${LARCH_QUIET_PID:-}" = "$$" ]; then
    56	        return 0
    57	    fi
