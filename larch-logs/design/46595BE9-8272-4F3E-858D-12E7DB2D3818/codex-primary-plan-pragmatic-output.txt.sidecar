   167	    mkdir -p "$(dirname "$path")" || larch_log_fail 2 "cannot create manifest directory"
   168	    tmp="$(mktemp "$(dirname "$path")/.tmp.manifest.XXXXXX")" || larch_log_fail 2 "cannot create manifest temp"
