     1	#!/usr/bin/env bash
     2	# session-setup.sh — Shared session setup for all skills.
     3	#
     4	# Consolidates the common Step 0 operations: preflight, temp dir creation,
     5	# repo name derivation, and reviewer binary presence detection.
     6	#
     7	# Usage:
     8	#   session-setup.sh --prefix <name> [--skip-preflight] [--skip-branch-check] \
     9	#     [--skip-repo-check] [--check-reviewers] \
    10	#     [--skip-codex-probe] [--skip-cursor-probe] \
    11	#     [--write-session-env <path>] [--caller-env <path>]
    12	#
    13	# Flags:
    14	#   --prefix <name>       (required) Temp dir prefix for mktemp (e.g., claude-implement)
    15	#   --skip-preflight      Skip preflight.sh call entirely (for skills with no preflight)
    16	#   --skip-branch-check   Forwarded to preflight.sh (skip the on-main assertion only;
    17	#                          the clean-tree assertion still runs unless the caller also
    18	#                          forwards --skip-clean-check, which session-setup.sh does NOT
    19	#                          do today). Continuation-from-feature-branch flows still
    20	#                          reject dirty trees by design; pre-stash any WIP first.
    21	#   --skip-repo-check     Skip repo name derivation entirely
    22	#   --check-reviewers     Run check-reviewers.sh and emit presence/availability keys
    23	#   --skip-codex-probe    Forwarded to check-reviewers.sh (skip Codex presence check)
    24	#   --skip-cursor-probe   Forwarded to check-reviewers.sh (skip Cursor presence check)
    25	#   --write-session-env <path>  Write full session-env file via write-session-env.sh
    26	#   --caller-env <path>   Path to KEY=value file with already-discovered values.
    27	#                          Recognized keys: REPO, REPO_UNAVAILABLE,
    28	#                          CODEX_PRESENT, CURSOR_PRESENT, CODEX_AVAILABLE, CURSOR_AVAILABLE,
    29	#                          CODEX_BINARY_FOUND, CURSOR_BINARY_FOUND,
    30	#                          LARCH_TOKEN_SESSION_ID, LARCH_CLAUDE_SOURCE_FILE,
    31	#                          LARCH_TIMING_LEDGER, PREV_IMPLEMENT_TMPDIR,
    32	#                          LARCH_DYNAMIC_ARCHETYPES_MAX.
    33	#                          If a key is present and non-empty, the script skips re-deriving it.
    34	#                          SESSION_TMPDIR is never inherited — a fresh tmpdir is always created.
    35	#                          If the file does not exist or is empty, full discovery happens.
    36	#
    37	# Output (KEY=value lines on stdout):
    38	#   SESSION_TMPDIR=<path>       Always output (fresh per invocation)
    39	#   SESSION_ID=<value>          Always output (also written to SESSION_TMPDIR/session-id)
    40	#   LARCH_RENDER_CACHE_DIR=<path> Always output (session-scoped renderer cache)
    41	#   REPO=<owner/repo>           Output unless --skip-repo-check
    42	#   REPO_UNAVAILABLE=true|false Output unless --skip-repo-check
    43	#   CODEX_PRESENT=true|false    Output when --check-reviewers, or passthrough from --caller-env
    44	#   CURSOR_PRESENT=true|false   Output when --check-reviewers, or passthrough from --caller-env
    45	#   CODEX_AVAILABLE/CURSOR_AVAILABLE  Backward-compat aliases for CODEX_PRESENT/CURSOR_PRESENT
    46	#   CODEX_BINARY_FOUND=true|false  Output when --check-reviewers (command -v before probe)
    47	#   CURSOR_BINARY_FOUND=true|false Output when --check-reviewers
    48	#   LARCH_TOKEN_SESSION_ID=<id> Output when passthrough from --caller-env, in both probe and passthrough branches
    49	#   LARCH_CLAUDE_SOURCE_FILE=<path> Output when passthrough from --caller-env, in both probe and passthrough branches
    50	#   LARCH_TIMING_LEDGER is forwarded to write-session-env.sh only when supplied via --caller-env; it is intentionally NOT echoed on stdout.
    51	#   LARCH_DYNAMIC_ARCHETYPES_MAX is forwarded to write-session-env.sh only when supplied via --caller-env and validated as 0..8; it is intentionally NOT echoed on stdout.
    52	#
    53	# On preflight failure, outputs PREFLIGHT_ERROR=<message> and exits non-zero.
    54	#
    55	# Exit codes:
    56	#   0 — success
    57	#   1-3 — passthrough from preflight.sh
    58	#   4 — missing --prefix or other session-setup.sh error
    59	
    60	set -euo pipefail
    61	
    62	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    63	# shellcheck source=scripts/lib-quiet.sh
    64	source "$SCRIPT_DIR/lib-quiet.sh"
    65	larch_quiet_init
    66	
    67	PREFIX=""
    68	SKIP_PREFLIGHT=false
    69	SKIP_BRANCH_CHECK=false
    70	SKIP_REPO_CHECK=false
    71	CHECK_REVIEWERS=false
    72	SKIP_CODEX_PROBE=false
    73	SKIP_CURSOR_PROBE=false
    74	WRITE_SESSION_ENV=""
    75	CALLER_ENV=""
    76	
    77	while [[ $# -gt 0 ]]; do
    78	    case "$1" in
    79	        --prefix)
    80	            [[ $# -ge 2 ]] || { larch_err "session-setup.sh: --prefix requires a value"; exit 4; }
    81	            PREFIX="$2"; shift 2 ;;
    82	        --skip-preflight)
    83	            SKIP_PREFLIGHT=true; shift ;;
    84	        --skip-branch-check)
    85	            SKIP_BRANCH_CHECK=true; shift ;;
    86	        --skip-repo-check)
    87	            SKIP_REPO_CHECK=true; shift ;;
    88	        --check-reviewers)
    89	            CHECK_REVIEWERS=true; shift ;;
    90	        --skip-codex-probe)
    91	            SKIP_CODEX_PROBE=true; shift ;;
    92	        --skip-cursor-probe)
    93	            SKIP_CURSOR_PROBE=true; shift ;;
    94	        --write-session-env)
    95	            [[ $# -ge 2 ]] || { larch_err "session-setup.sh: --write-session-env requires a path"; exit 4; }
    96	            WRITE_SESSION_ENV="$2"; shift 2 ;;
    97	        --caller-env)
    98	            [[ $# -ge 2 ]] || { larch_err "session-setup.sh: --caller-env requires a path"; exit 4; }
    99	            CALLER_ENV="$2"; shift 2 ;;
   100	        *)
   101	            larch_err "session-setup.sh: unknown option: $1"
   102	            exit 4 ;;
   103	    esac
   104	done
   105	
   106	if [[ -z "$PREFIX" ]]; then
   107	    larch_err "session-setup.sh: --prefix is required"
   108	    exit 4
   109	fi
   110	
   111	# --- Read caller-env file (if provided and exists) ---
   112	# Parse line-by-line; do NOT source. Only recognized keys with non-empty values are used.
   113	CALLER_REPO=""
   114	CALLER_REPO_UNAVAILABLE=""
   115	CALLER_CODEX_PRESENT=""
   116	CALLER_CURSOR_PRESENT=""
   117	CALLER_CODEX_BINARY_FOUND=""
   118	CALLER_CURSOR_BINARY_FOUND=""
   119	CALLER_TOKEN_SESSION_ID=""
   120	CALLER_CLAUDE_SOURCE_FILE=""
   121	CALLER_TIMING_LEDGER=""
   122	CALLER_PREV_IMPLEMENT_TMPDIR=""
   123	CALLER_DYNAMIC_ARCHETYPES_MAX=""
   124	
   125	if [[ -n "$CALLER_ENV" && -f "$CALLER_ENV" ]]; then
   126	    # Use explicit `${line%%=*}` / `${line#*=}` parameter expansion instead
   127	    # of `IFS='=' read -r key value` so the value field is unambiguously
   128	    # split on the FIRST `=` only. Bash `read` with two variables already
   129	    # assigns the remainder to the last variable (so embedded `=` is
   130	    # preserved), but the explicit form is self-documenting and avoids
   131	    # depending on the `read`-with-two-vars edge case (post-review).
   132	    while IFS= read -r line || [[ -n "$line" ]]; do
   133	        [[ -z "$line" || "$line" =~ ^# ]] && continue
   134	        [[ "$line" != *"="* ]] && continue
   135	        key="${line%%=*}"
   136	        value="${line#*=}"
   137	        [[ -z "$key" ]] && continue
   138	        case "$key" in
   139	            REPO)              CALLER_REPO="$value" ;;
   140	            REPO_UNAVAILABLE)  CALLER_REPO_UNAVAILABLE="$value" ;;
   141	            CODEX_PRESENT|CODEX_AVAILABLE)     CALLER_CODEX_PRESENT="$value" ;;
   142	            CURSOR_PRESENT|CURSOR_AVAILABLE)    CALLER_CURSOR_PRESENT="$value" ;;
   143	            CODEX_BINARY_FOUND) CALLER_CODEX_BINARY_FOUND="$value" ;;
   144	            CURSOR_BINARY_FOUND) CALLER_CURSOR_BINARY_FOUND="$value" ;;
   145	            LARCH_TOKEN_SESSION_ID) CALLER_TOKEN_SESSION_ID="$value" ;;
   146	            LARCH_CLAUDE_SOURCE_FILE) CALLER_CLAUDE_SOURCE_FILE="$value" ;;
   147	            LARCH_TIMING_LEDGER) CALLER_TIMING_LEDGER="$value" ;;
   148	            PREV_IMPLEMENT_TMPDIR) CALLER_PREV_IMPLEMENT_TMPDIR="$value" ;;
   149	            LARCH_DYNAMIC_ARCHETYPES_MAX) CALLER_DYNAMIC_ARCHETYPES_MAX="$value" ;;
   150	            *)                 ;; # Ignore unknown keys
   151	        esac
   152	    done < "$CALLER_ENV"
   153	fi
   154	
   155	is_path_under_root() {
   156	    local path="$1"
   157	    local root="$2"
   158	    local path_dir
   159	    local path_base
   160	    local path_real
   161	    local root_real
   162	
   163	    [[ -n "$root" ]] || return 1
   164	    root_real=$(cd "$root" 2>/dev/null && pwd -P) || return 1
   165	    path_dir=$(dirname "$path")
   166	    path_base=$(basename "$path")
   167	    path_real=$(cd "$path_dir" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$path_base") || return 1
   168	
   169	    [[ "$path_real" == "$root_real" || "$path_real" == "$root_real/"* ]]
   170	}
   171	
   172	is_safe_timing_ledger_path() {
   173	    local path="$1"
   174	    local caller_env_dir="$2"
   175	    local root
   176	
   177	    [[ -n "$path" ]] || return 1
   178	    [[ "$path" != *$'\n'* && "$path" != *$'\r'* ]] || return 1
   179	    [[ "$path" == /* ]] || return 1
   180	    [[ ${#path} -le 512 && "$path" =~ ^[A-Za-z0-9_./~+-]+$ ]] || return 1

