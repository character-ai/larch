     2	# Sourced title-marker grammar helpers. Bash 3.2-compatible; do not execute.
     3	
     4	# insert_signal_marker <title> <marker>
     5	# Echoes <title> with [<marker>] inserted into the leading bracket-block
     6	# sequence. Full contract lives in scripts/tracking-issue-write.md.
     7	insert_signal_marker() {
     8	    local title="$1"
     9	    local marker="$2"
    10	    local marker_block="[$marker]"
    11	    local rest="$title"
    12	    local after_open block after_block
    13	    local found=false
    14	
    15	    if [ -z "$title" ]; then
    16	        printf '[%s]' "$marker"
    17	        return 0
    18	    fi
    19	
    20	    while [[ "$rest" == \[* ]]; do
    21	        after_open="${rest#\[}"
    22	        case "$after_open" in
    23	            *'] '*)
    24	                block="[${after_open%%] *}]"
    25	                after_block="${after_open#*] }"
    26	                if [ "$block" = "$marker_block" ]; then
    27	                    found=true
    28	                    break
    29	                fi
    30	                rest="$after_block"
    31	                ;;
    32	            *)
    33	                break
    34	                ;;
    35	        esac
    36	    done
    37	
    38	    if [ "$found" = true ]; then
    39	        printf '%s' "$title"
    40	        return 0
    41	    fi
    42	
    43	    case "$title" in
    44	        '[IN PROGRESS] '*)
    45	            printf '[IN PROGRESS] [%s] %s' "$marker" "${title#\[IN PROGRESS\] }"
    46	            ;;
    47	        '[DONE] '*)
    48	            printf '[DONE] [%s] %s' "$marker" "${title#\[DONE\] }"
    49	            ;;
    50	        '[STALLED] '*)
    51	            printf '[STALLED] [%s] %s' "$marker" "${title#\[STALLED\] }"
    52	            ;;
    53	        *)
    54	            printf '[%s] %s' "$marker" "$title"
    55	            ;;
    56	    esac
    57	}

