    65	        *) log_dir="." ;;
    66	    esac
    67	    mkdir -p "$log_dir" 2>/dev/null || return 0
    68	    : > "$log_file" 2>/dev/null || return 0
    69	
    70	    exec 3>&1
    71	    exec 4>&2
    72	    export LARCH_QUIET_ACTIVE=1
    73	    export LARCH_QUIET_PID=$$
    74	    export LARCH_QUIET_LOG_FILE="$log_file"
    75	    exec >>"$log_file" 2>&1
    76	}
