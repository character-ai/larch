   402	# ---------------------------------------------------------------------------
   403	# lock_and_rename_then_emit <issue-num> <issue-title>
   404	#
   405	# Acquires the comment lock by delegating to issue-lifecycle.sh comment --lock,
   406	# then attempts a best-effort title rename via tracking-issue-write.sh rename
   407	# --state in-progress. Emits the unified stdout contract and exits.
   408	#
   409	# Stdout filtering: delegate stdout is captured into local variables and parsed
   410	# key-by-key. Only the unified contract keys (ELIGIBLE, ISSUE_NUMBER,
   411	# ISSUE_TITLE, LOCK_ACQUIRED, RENAMED, ERROR) are echoed. Auxiliary delegate
   412	# keys (COMMENTED, FAILED, NEW_TITLE, etc.) are filtered out so the SKILL.md
   413	# parser sees a clean contract.
   414	#
   415	# set -e guards: the lock and rename calls are wrapped with `|| <var>=$?` so
   416	# a non-zero exit from the delegate does not prematurely abort find-lock-
   417	# issue.sh under `set -euo pipefail` — the script must still emit its own
   418	# unified contract before exiting.
   419	#
   420	# Exit codes (terminal — does not return):
   421	#   0  — lock acquired (rename may have succeeded or failed best-effort)
   422	#   3  — eligibility passed but lock acquisition failed
   423	# ---------------------------------------------------------------------------
   424	lock_and_rename_then_emit() {
   425	    local issue_num="$1"
   426	    local issue_title="$2"
   427	    local lock_script rename_script
   428	    lock_script="${SCRIPT_DIR}/issue-lifecycle.sh"
   429	    rename_script="${SCRIPT_DIR}/../../../scripts/tracking-issue-write.sh"
   430	
   431	    _pre_lock_clean_tree_and_main_sync_gate "$issue_num" "$issue_title" "" ""
   432	
   433	    _require_plan_block_before_lock "$issue_num" "$issue_title"
   434	
   435	    # ---- Acquire comment lock (correctness invariant) ----
   436	    local lock_out lock_exit=0
   437	    lock_out=$("$lock_script" comment --issue "$issue_num" --body "IN PROGRESS" --lock 2>&1) || lock_exit=$?
   438	
   439	    # Parse LOCK_ACQUIRED and ERROR from delegate stdout. Use awk's last-line-
   440	    # wins for each key so the same key appearing multiple times resolves to
   441	    # the final value. Auxiliary keys (COMMENTED, etc.) are not extracted.
   442	    local lock_acquired lock_error
   443	    lock_acquired=$(echo "$lock_out" | awk -F= '/^LOCK_ACQUIRED=/ { v=$2 } END { print v }')
   444	    lock_error=$(echo "$lock_out" | awk -F= '/^ERROR=/ { sub(/^ERROR=/, "", $0); v=$0 } END { print v }')
   445	
   446	    if [ "$lock_acquired" != "true" ] || [ "$lock_exit" -ne 0 ]; then
   447	        # Lock failed. Surface the unified contract; preserve eligibility
   448	        # signal (ELIGIBLE=true) so callers can distinguish eligibility-pass
   449	        # from successful lock acquisition.
   450	        emit_kv ELIGIBLE true
   451	        emit_kv ISSUE_NUMBER "$issue_num"
   452	        emit_kv ISSUE_TITLE "$issue_title"
   453	        emit_kv LOCK_ACQUIRED false
   454	        if [ -n "$lock_error" ]; then
   455	            emit_kv ERROR "$lock_error"
   456	        else
   457	            emit_kv ERROR "Lock acquisition failed (issue-lifecycle.sh exit $lock_exit)"
   458	        fi
   459	        exit 3
   460	    fi
   461	
   462	    # ---- Rename title (best-effort) ----
   463	    local rename_out rename_exit=0 renamed=false rename_error=""
   464	    rename_out=$("$rename_script" rename --issue "$issue_num" --state in-progress --repo "$REPO" 2>&1) || rename_exit=$?
   465	
   466	    # Parse RENAMED (true/false). RENAMED=false is BOTH the idempotent no-op
   467	    # path AND the failure path; distinguish via FAILED= or non-zero exit.
   468	    local rename_failed
   469	    renamed=$(echo "$rename_out" | awk -F= '/^RENAMED=/ { v=$2 } END { print v }')
   470	    rename_failed=$(echo "$rename_out" | awk -F= '/^FAILED=/ { v=$2 } END { print v }')
   471	    rename_error=$(echo "$rename_out" | awk -F= '/^ERROR=/ { sub(/^ERROR=/, "", $0); v=$0 } END { print v }')
   472	
   473	    if [ "$rename_exit" -ne 0 ] || [ "$rename_failed" = "true" ]; then
   474	        # Rename failed. Best-effort: lock is the correctness boundary; do
   475	        # not undo it. Surface the failure on stderr; emit RENAMED=false on
   476	        # stdout. /implement Step 0.5 Branch 2's idempotent rename is the
   477	        # safety net.
   478	        if [ -n "$rename_error" ]; then
   479	            larch_err "WARNING: title rename failed for issue #$issue_num: $rename_error"
   480	        else
   481	            larch_err "WARNING: title rename failed for issue #$issue_num (tracking-issue-write.sh exit $rename_exit)"
   482	        fi
   483	        renamed="false"
   484	    fi
   485	
   486	    # Normalize: empty (older script versions or unexpected output) → false.
   487	    if [ -z "$renamed" ]; then
   488	        renamed="false"
   489	    fi
   490	
   491	    # ---- Emit unified contract ----
   492	    emit_kv ELIGIBLE true
   493	    emit_kv ISSUE_NUMBER "$issue_num"
   494	    emit_kv ISSUE_TITLE "$issue_title"
   495	    emit_kv LOCK_ACQUIRED true
   496	    emit_kv RENAMED "$renamed"
   497	    exit 0
   498	}
   499	
   500	# ---------------------------------------------------------------------------
   501	# lock_and_rename_then_emit_for_child <child-num> <child-title>
   502	#                                     <umbrella-num> <umbrella-title>
   503	#
   504	# Umbrella child-dispatch lock path. Same shape as
   505	# lock_and_rename_then_emit (above), but emits the unified contract WITH
   506	# umbrella-context keys (IS_UMBRELLA, UMBRELLA_NUMBER, UMBRELLA_TITLE,
   507	# UMBRELLA_ACTION=dispatched).
   508	#
   509	# On child lock failure, exits 3 with an ERROR string that names BOTH the
   510	# child and the umbrella so SKILL.md Step 0's exit-3 branch can present a
   511	# clear error to the operator.
   512	# ---------------------------------------------------------------------------
   513	lock_and_rename_then_emit_for_child() {
   514	    local child_num="$1"
   515	    local child_title="$2"
   516	    local umbrella_num="$3"
   517	    local umbrella_title="$4"
   518	    local lock_script rename_script
   519	    lock_script="${SCRIPT_DIR}/issue-lifecycle.sh"
   520	    rename_script="${SCRIPT_DIR}/../../../scripts/tracking-issue-write.sh"

 succeeded in 0ms:
     1	#!/usr/bin/env bash
     2	# find-lock-issue.sh — Verify an explicit issue, lock it, and rename it to [IN PROGRESS].
     3	#
     4	# Explicit-target-only pipeline invoked by /fix-issue Step 0. Requires a
     5	# positional issue number or URL argument. Runs four operations in sequence:
     6	#   1. Verify the explicit issue (open, not managed-prefix, not blocked).
     7	#   2. Probe the local working tree with scripts/check-clean-tree.sh
     8	#      --fail-closed. Dirty or unknown cleanliness aborts before any GitHub
     9	#      mutation so the original title remains intact.
    10	#   3. Acquire the comment-based concurrency lock by delegating to
    11	#      issue-lifecycle.sh comment --lock (posts "IN PROGRESS", post-checks
    12	#      for duplicate races). The comment lock is the correctness invariant.
    13	#   4. Rename the issue title to "[IN PROGRESS] <title>" by delegating to
    14	#      tracking-issue-write.sh rename --state in-progress. Best-effort: a
    15	#      rename failure does NOT undo the lock — the script still exits 0
    16	#      with LOCK_ACQUIRED=true RENAMED=false. /implement Step 0.5 Branch 2
    17	#      is the safety net (idempotent re-attempt on the next run-segment).
    18	#
    19	# Targets a specific issue (by number or GitHub URL), verifies it is open,
    20	# runs umbrella detection FIRST (issue #819 DECISION_1 — if the issue is an
    21	# umbrella, the umbrella branch is taken and managed-prefix rejection is
    22	# bypassed so umbrellas with `[IN PROGRESS]` / `[DONE]` / `[STALLED]`
    23	# titles remain explicitly targetable), then for non-umbrellas verifies the
    24	# title does not carry a managed lifecycle title prefix or a [... Report]
    25	# pattern, and has no currently-open blocking dependencies.
    26	#
    27	# Two orthogonal mechanisms coexist:
    28	#   1) Comment-based "IN PROGRESS" lock — concurrency control on the
    29	#      fix-issue subject issue. Acquired here at /fix-issue Step 0 (last
    30	#      comment = exactly "IN PROGRESS"); cleared when work completes.
    31	#      Prevents two concurrent /fix-issue runners from colliding on the same
    32	#      subject.
    33	#   2) Title-based "[IN PROGRESS]" / "[DONE]" / "[STALLED]" lifecycle —
    34	#      machine-owned tracking-issue state. Applied here at lock time so
    35	#      the title reflects active work immediately, instead of the
    36	#      multi-minute delay incurred when only /implement Step 0.5 Branch 2
    37	#      did the rename. /implement still re-attempts the rename idempotently
    38	#      so standalone /implement remains correct when invoked with positional
    39	#      <issue-N> against a non-pre-marked issue.
    40	#
    41	# Usage:
    42	#   find-lock-issue.sh <number-or-url>
    43	#
    44	# Output (KEY=value lines on stdout):
    45	#   ELIGIBLE=true|false
    46	#   ISSUE_NUMBER=<N>          (when ELIGIBLE=true; on the umbrella-dispatch
    47	#                              path, this is the CHOSEN CHILD's number)
    48	#   ISSUE_TITLE=<title>       (when ELIGIBLE=true; the chosen child's title
    49	#                              on the umbrella-dispatch path)
    50	#   LOCK_ACQUIRED=true|false  (true on exit 0; false on exit 3 — lock-fail —
    51	#                              and false on exit 4 — umbrella complete, no
    52	#                              lock attempted)
    53	#   RENAMED=true|false        (when LOCK_ACQUIRED=true; false = idempotent
    54	#                              no-op OR rename API failure; rename errors
    55	#                              additionally surfaced on stderr)
    56	#   ERROR=<message>           (when ELIGIBLE=false and exit 2, or when exit 3,
    57	#                              or when exit 5 — no eligible umbrella child)
    58	#
    59	#   Umbrella-only keys (FINDING_1 from the umbrella-PR plan review — emitted
    60	#   ONLY when the umbrella detector returned IS_UMBRELLA=true):
    61	#   IS_UMBRELLA=true          (only on umbrella paths — exit 0 dispatch,
    62	#                              exit 3 child-lock-fail, exit 4 complete,
    63	#                              exit 5 no-eligible-child)
    64	#   UMBRELLA_NUMBER=<U>       (the umbrella issue number)
    65	#   UMBRELLA_TITLE=<title>    (umbrella's title, when IS_UMBRELLA=true)
    66	#   UMBRELLA_ACTION           (one of: dispatched | complete | no-eligible-
    67	#                              child — describes the umbrella outcome)
    68	#
    69	# Exit codes:
    70	#   0 — eligible issue found, comment lock acquired. On umbrella paths,
    71	#       UMBRELLA_ACTION=dispatched and ISSUE_NUMBER refers to the chosen
    72	#       child (rename may have failed best-effort — RENAMED=false signals).
    73	#   2 — error: missing argument, gh CLI failure, explicit issue not eligible,
    74	#       umbrella blocked by open dependencies, or umbrella-handler.sh detect
    75	#       failure (closes #891). Also used for pre-lock dirty-tree aborts
    76	#       before any GitHub mutation: ordinary paths emit ELIGIBLE=false
    77	#       ERROR=Working tree is not clean..., while umbrella child paths also
    78	#       emit IS_UMBRELLA=true UMBRELLA_NUMBER, UMBRELLA_TITLE, ISSUE_NUMBER,
    79	#       ISSUE_TITLE, and LOCK_ACQUIRED=false.
    80	#   3 — eligible issue found but comment lock could not be acquired
    81	#       (concurrent runner won the race; on umbrella paths, the failure is
    82	#       on the chosen child and ERROR carries umbrella context)
    83	#   4 — umbrella complete: all parsed children are CLOSED. SKILL.md Step 0
    84	#       invokes finalize-umbrella.sh on this path. ELIGIBLE=true with
    85	#       LOCK_ACQUIRED=false (no lock; finalization is a different state
    86	#       transition).
    87	#   5 — umbrella detected but has no eligible child (some children open but
    88	#       all blocked / locked / managed-prefixed, OR zero parseable children
    89	#       found in the umbrella body — FINDING_3). ELIGIBLE=false, ERROR
    90	#       carries the blocking reason.
    91	#   6 — PR plan probe failed before lock (--require-plan-block only): missing
    92	#       or malformed larch:plan markers (PLAN_PROBE_FAILED). ELIGIBLE=true,
    93	#       LOCK_ACQUIRED=false; no IN PROGRESS comment is posted. Aligns with
    94	#       skills/fix-issue/scripts/find-lock-issue.md.
    95	#
    96	# Stdout contract policy: delegate stdout (issue-lifecycle.sh, tracking-
    97	# issue-write.sh) is captured into local shell variables and parsed
    98	# key-by-key; never streamed. find-lock-issue.sh emits the keys declared
    99	# above. Before a successful lock, the pre-lock gate may emit
   100	# `MAIN_SYNC_HARD_RESET=true` and `SYNC_STATUS=reset` when check-main-sync
   101	# auto-reset local `main` to `origin/main` (see `_pre_lock_clean_tree_and_main_sync_gate`).
   102	# Auxiliary delegate keys (COMMENTED, FAILED, NEW_TITLE,
   103	# etc.) are filtered out so the SKILL.md parser sees a clean unified
   104	# contract.
   105	#
   106	# Umbrella support (explicit-issue path only):
   107	#   When the explicit issue is detected as an umbrella (title-only post-#846
   108	#   — case-sensitive, after stripping zero or more leading bracket-blocks of
   109	#   the form `[...]` and/or `(...)` per #819, the remainder begins with
   110	#   `Umbrella: ` or `Umbrella — `; body content is NOT consulted), delegate
   111	#   to umbrella-handler.sh to either:
   112	#     - dispatch to the next-eligible child (pick-child returns CHILD_NUMBER),
   113	#       lock the CHILD using --lock, rename the CHILD to [IN PROGRESS]. Emit
   114	#       IS_UMBRELLA=true UMBRELLA_NUMBER=<U> UMBRELLA_TITLE=<T>
   115	#       UMBRELLA_ACTION=dispatched alongside the existing ISSUE_NUMBER
   116	#       (= child) keys. Exit 0.
   117	#     - finalize the umbrella when all parsed children are CLOSED
   118	#       (pick-child returns ALL_CLOSED=true). Emit IS_UMBRELLA=true
   119	#       UMBRELLA_NUMBER=<U> UMBRELLA_TITLE=<T> UMBRELLA_ACTION=complete.
   120	#       Exit 4. SKILL.md Step 0 invokes finalize-umbrella.sh.
   121	#     - report no-eligible-child (pick-child returns NO_ELIGIBLE_CHILD).
   122	#       Emit IS_UMBRELLA=true UMBRELLA_NUMBER=<U> UMBRELLA_ACTION=
   123	#       no-eligible-child + ERROR=<reason>. Exit 5.
   124	#   On child lock failure, emit exit 3 with ERROR carrying the umbrella
   125	#   context ("Failed to lock chosen child #C of umbrella #U: <reason>").
   126	#   UMBRELLA_NUMBER is emitted ONLY when an umbrella was detected — absent
   127	#   on the normal (non-umbrella) explicit-issue exit-0 path, per FINDING_1
   128	#   from the umbrella-PR plan review.
   129	
   130	set -euo pipefail
   131	
   132	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
   133	# shellcheck source=scripts/lib-quiet.sh
   134	source "$SCRIPT_DIR/../../../scripts/lib-quiet.sh"
   135	larch_quiet_init
   136	
   137	# Returns 0 if the title starts with a managed lifecycle prefix
   138	# ("[IN PROGRESS] ", "[DONE] ", "[STALLED] "), 1 otherwise. Anchored at
   139	# the start; trailing-space-sensitive (matches the helper exactly — no
   140	# fuzzy match, so user titles containing the literal substring "[IN
   141	# PROGRESS]" mid-text are NOT excluded). The optional "[ROUND-TRIP] "
   142	# marker is intentionally NOT a managed-prefix gate here: it is a signal,
   143	# not a lock, so a title with only that marker remains pickable.
   144	has_managed_prefix() {
   145	    local t="$1"
   146	    case "$t" in
   147	        '[IN PROGRESS] '*) return 0 ;;
   148	        '[DONE] '*)        return 0 ;;
   149	        '[STALLED] '*)     return 0 ;;
   150	        *)                 return 1 ;;
   151	    esac
   152	}
   153	
   154	# Returns 0 if the title matches the [... Report] pattern — a bracket-enclosed
   155	# phrase ending with " report]" (case-insensitive) at the start of the title
   156	# (e.g. "[Weekly Report]", "[AUDIT REPORT] Q3", "[analysis report]"). These
   157	# are report/analytics issues not meant for automated fixing. Run-logs audit
   158	# report titles use `[Run Logs Audit <timestamp> Report] …`, which also match
   159	# this pattern; combined with the `audit-report` label check, they stay
   160	# excluded from /fix-issue.
   161	has_report_prefix() {
   162	    printf '%s' "$1" | grep -qiE '^\[[^]]*[[:space:]]+report\]'
   163	}
