   240	# of `origin/main` with `chore(larch-logs): flush *` commits touching
   241	# `larch-logs/` alone, that script may run **git reset --hard origin/main** —
   242	# a destructive branch move. Operators must treat a successful reset as
   243	# dropping local-only SHAs on main until they re-fetch/reconcile elsewhere.
   244	# Emits MAIN_SYNC_HARD_RESET=true and SYNC_STATUS=reset on stdout when a reset
   245	# occurred (breadcrumb for transcripts); see find-lock-issue.md.
   246	# ---------------------------------------------------------------------------
   247	_pre_lock_clean_tree_and_main_sync_gate() {
   248	    local issue_num="$1"
   249	    local issue_title="$2"
   250	    local umbrella_num="${3:-}"
   251	    local umbrella_title="${4:-}"
   252	    local check_script="${SCRIPT_DIR}/../../../scripts/check-clean-tree.sh"
   253	
   254	    local probe_out probe_exit=0
   255	    probe_out=$("$check_script" --fail-closed 2>&1) || probe_exit=$?
   256	
   257	    local clean_line
   258	    clean_line=$(printf '%s\n' "$probe_out" | awk -F= '/^CLEAN=/ { v=$2 } END { print v }')
   259	
   260	    if [ "$probe_exit" -eq 0 ] && [ "$clean_line" = "true" ]; then
   261	        # Working tree is clean. Also check for committed-but-unpushed
   262	        # larch-log flush commits on main. No fetch: we use the locally-cached
   263	        # origin/main ref — see check-main-sync.md for the rationale.
   264	        local sync_script="${SCRIPT_DIR}/../../../scripts/check-main-sync.sh"
   265	        if [ ! -f "$sync_script" ]; then
   266	            emit_kv ELIGIBLE false
   267	            emit_kv ERROR "check-main-sync.sh missing at $sync_script; cannot verify main sync before lock."
   268	            exit 2
   269	        fi
   270	        local sync_out sync_exit=0
   271	        sync_out=$(bash "$sync_script" 2>&1) || sync_exit=$?
   272	        local sync_status
   273	        sync_status=$(printf '%s\n' "$sync_out" | awk -F= '/^SYNC_STATUS=/ { v=$2 } END { print v }')
   274	        if [ "$sync_exit" -eq 1 ] || [ "$sync_status" = "blocked" ]; then
   275	            local sync_error
   276	            sync_error=$(printf '%s\n' "$sync_out" | awk -F= '/^ERROR=/ { sub(/^ERROR=/, "", $0); v=$0 } END { print v }')
   277	            emit_kv ELIGIBLE false
   278	            if [ -n "$umbrella_num" ]; then
   279	                emit_kv IS_UMBRELLA true
   280	                emit_kv UMBRELLA_NUMBER "$umbrella_num"
   281	                emit_kv UMBRELLA_TITLE "$umbrella_title"
   282	                emit_kv ISSUE_NUMBER "$issue_num"
   283	                emit_kv ISSUE_TITLE "$issue_title"
   284	                emit_kv LOCK_ACQUIRED false
   285	            fi
   286	            emit_kv ERROR "${sync_error:-local main is ahead of origin/main with non-log commits; push or reconcile before re-running /fix-issue. No issue was locked.}"
   287	            exit 2
   288	        fi
   289	        # Exit 2 with SYNC_STATUS=probe-error: fail closed when origin/main is
   290	        # present (stale ref / flaky git can hide unsafe ahead state). When
   291	        # origin/main is absent (fresh repo, offline harness), keep fail-open
   292	        # so the comment-lock invariant is not blocked on missing remotes.
   293	        if [ "$sync_exit" -eq 2 ] && [ "$sync_status" = "probe-error" ]; then
   294	            local repo_top
   295	            repo_top=$(git rev-parse --show-toplevel 2>/dev/null || true)
   296	            if [ -n "$repo_top" ] && git -C "$repo_top" rev-parse -q --verify origin/main >/dev/null 2>&1; then
   297	                emit_kv ELIGIBLE false
   298	                if [ -n "$umbrella_num" ]; then
   299	                    emit_kv IS_UMBRELLA true
   300	                    emit_kv UMBRELLA_NUMBER "$umbrella_num"
   301	                    emit_kv UMBRELLA_TITLE "$umbrella_title"
   302	                    emit_kv ISSUE_NUMBER "$issue_num"
   303	                    emit_kv ISSUE_TITLE "$issue_title"
   304	                    emit_kv LOCK_ACQUIRED false
   305	                fi
   306	                emit_kv ERROR "Cannot verify local main is in sync with origin/main (git probe failed). Run: git fetch origin main — then retry /fix-issue. No issue was locked."
   307	                exit 2
   308	            fi
   309	        elif [ "$sync_exit" -ne 0 ]; then
   310	            emit_kv ELIGIBLE false
   311	            if [ -n "$umbrella_num" ]; then
   312	                emit_kv IS_UMBRELLA true
   313	                emit_kv UMBRELLA_NUMBER "$umbrella_num"
   314	                emit_kv UMBRELLA_TITLE "$umbrella_title"
   315	                emit_kv ISSUE_NUMBER "$issue_num"
   316	                emit_kv ISSUE_TITLE "$issue_title"
   317	                emit_kv LOCK_ACQUIRED false
   318	            fi
   319	            emit_kv ERROR "check-main-sync.sh exited unexpectedly (exit $sync_exit). No issue was locked."
   320	            exit 2
   321	        fi
   322	        # SYNC_STATUS=reset means flush commits were auto-cleared; ok or
   323	        # not-main also mean the run can proceed.
   324	        if [ "$sync_status" = "reset" ]; then
   325	            emit_kv MAIN_SYNC_HARD_RESET true
   326	            emit_kv SYNC_STATUS reset
   327	        fi
   328	        return 0
   329	    fi
   330	
   331	    emit_kv ELIGIBLE false
   332	    if [ -n "$umbrella_num" ]; then
   333	        emit_kv IS_UMBRELLA true
   334	        emit_kv UMBRELLA_NUMBER "$umbrella_num"
   335	        emit_kv UMBRELLA_TITLE "$umbrella_title"
   336	        emit_kv ISSUE_NUMBER "$issue_num"
   337	        emit_kv ISSUE_TITLE "$issue_title"
   338	        emit_kv LOCK_ACQUIRED false
   339	    fi
   340	
   341	    if [ "$probe_exit" -eq 0 ] && [ "$clean_line" = "false" ]; then
   342	        emit_kv ERROR "Working tree is not clean. Commit or stash changes, then re-run /fix-issue. No issue was locked."
   343	    else
   344	        local summary
   345	        summary=$(printf '%s\n' "$probe_out" | awk '/^PROBE_ERROR=/ { sub(/^PROBE_ERROR=/, "", $0); v=$0 } END { print v }')
   346	        [ -n "$summary" ] || summary="probe exited $probe_exit"
   347	        emit_kv ERROR "Cannot determine working-tree cleanliness: $summary"
   348	    fi
   349	    exit 2
   350	}
   351	
   352	# ---------------------------------------------------------------------------
   353	# _require_plan_block_before_lock <issue-num> <issue-title>
   354	#
   355	# When REQUIRE_PLAN_BLOCK=true (set via argv --require-plan-block), run
   356	# plan-block-read.sh on the issue that is about to receive the IN PROGRESS
   357	# lock — after dirty-tree passes, before issue-lifecycle.sh comment --lock.
   358	# Emits exit 6 with LOCK_ACQUIRED=false when the plan anchor is absent or
   359	# malformed, or exit 2 on gh/read hard failure.
   360	# ---------------------------------------------------------------------------
   361	_require_plan_block_before_lock() {
   362	    local issue_num="$1" issue_title="$2"
   363	    if [[ "$REQUIRE_PLAN_BLOCK" != "true" ]]; then
   364	        return 0
   365	    fi
   366	    local plan_read probe_tmp probe_out probe_rc=0
   367	    plan_read="${SCRIPT_DIR}/../../../scripts/plan-block-read.sh"
   368	    if [[ ! -f "$plan_read" ]]; then
   369	        emit_kv ELIGIBLE false
   370	        emit_kv ERROR "plan-block-read.sh not found at $plan_read"
   371	        exit 2
   372	    fi
   373	    probe_tmp=$(mktemp "${TMPDIR:-/tmp}/find-lock-plan-probe.XXXXXX")
   374	    probe_out=$("$plan_read" --issue "$issue_num" --output "$probe_tmp" --repo "$REPO" 2>&1) || probe_rc=$?
   375	    rm -f "$probe_tmp"
   376	    local block_present="" malformed=""
   377	    block_present=$(printf '%s' "$probe_out" | awk -F= '/^BLOCK_PRESENT=/ { v=$2 } END { print v }')
   378	    malformed=$(printf '%s' "$probe_out" | awk -F= '/^MALFORMED=/ { v=$2 } END { print v }')
   379	    if [[ "$probe_rc" -eq 2 ]]; then
   380	        local err_flat=""
   381	        err_flat=$(printf '%s' "$probe_out" | awk -F= '/^ERROR=/ { sub(/^ERROR=/, "", $0); v=$0 } END { print v }')
   382	        emit_kv ELIGIBLE false
   383	        emit_kv LOCK_ACQUIRED false
   384	        emit_kv ERROR "plan-block-read failed before lock: ${err_flat:-gh or repo read error}"
   385	        exit 2
   386	    fi
   387	    if [[ "$probe_rc" -eq 1 ]] || [[ "${block_present:-}" != "true" ]]; then
   388	        emit_kv ELIGIBLE true
   389	        emit_kv ISSUE_NUMBER "$issue_num"
   390	        emit_kv ISSUE_TITLE "$issue_title"
   391	        emit_kv LOCK_ACQUIRED false
   392	        emit_kv PLAN_PROBE_FAILED true
   393	        if [[ -n "$malformed" ]]; then
   394	            emit_kv MALFORMED "$malformed"
   395	        fi
   396	        emit_kv ERROR "missing or malformed larch:plan block — run /design $issue_num before /fix-issue"
   397	        exit 6
   398	    fi
   399	    return 0
   400	}
