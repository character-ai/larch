   252	            exit 0
   253	        fi
   254	        larch_log_atomic_replace "$tmp" "$path"
   255	        larch_log_emit_success "$path" true false
   256	        ;;
   257	
   258	    write-round)
   259	        LOG_ROOT=""; SKILL=""; RUN_ID=""; ROUND_NUM=""; SOURCE_DIR=""
   260	        round_dir=""; written=false; found=false; round_tmp=""; src=""; name=""; dest=""; dynamic_dir=""; seen_round_artifacts=""

