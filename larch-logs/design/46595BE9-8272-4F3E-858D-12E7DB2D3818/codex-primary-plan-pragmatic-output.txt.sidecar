   126	            # push errors rather than swallowing them — a stale remote on an
   127	            # OPEN PR is exactly the silent-failure mode this branch must avoid.
   128	            PUSH_STDERR=$(mktemp)
   129	            if git push -u origin HEAD >/dev/null 2>"$PUSH_STDERR"; then
   130	                : # plain push succeeded (fast-forward or already-in-sync)
   131	            else
   132	                # Plain push failed — commonly non-fast-forward after history
   133	                # rewrite (e.g., /implement Step 12 rebase + re-bump). Escalate
   134	                # to force-with-lease via the shared helper, which encodes
   135	                # lease + race-recovery + single retry.
   136	                # The helper does `git push --force-with-lease` with no refspec
   137	                # and requires upstream tracking + a populated origin/$BRANCH ref:
   138	                git fetch origin "$BRANCH" 2>/dev/null || true
   139	                git branch --set-upstream-to="origin/$BRANCH" "$BRANCH" >/dev/null 2>&1 || true
   140	                # Suppress helper stdout (BRANCH=/PUSHED=/STATUS= keys) so the
   141	                # PR_* stdout contract this script publishes stays intact;
   142	                # capture helper stderr to surface on real failure.
   143	                if ! "$SCRIPT_DIR/git-force-push.sh" >/dev/null 2>>"$PUSH_STDERR"; then
   144	                    larch_err "ERROR: Failed to push branch on existing-PR fast-path: $(cat "$PUSH_STDERR")"
   145	                    exit 1
   146	                fi
   147	            fi
   148	            # Fetch the existing PR title
   149	            PR_TITLE=$(echo "$EXISTING_PR" | jq -r '.title // empty' 2>/dev/null || echo "")
   150	            if [[ -z "$PR_TITLE" ]]; then
   151	                PR_TITLE=$(gh pr view "$PR_NUMBER" ${GH_REPO_ARGS[@]+"${GH_REPO_ARGS[@]}"} --json title -q '.title' 2>/dev/null || echo "")
   152	            fi
   153	            emit_kv PR_NUMBER "$PR_NUMBER"
   154	            emit_kv PR_URL "$PR_URL"
   155	            emit_kv PR_TITLE "$PR_TITLE"
   156	            emit_kv PR_STATUS "existing"
   157	            exit 0
   158	        fi
   159	    fi
   160	fi
   161	
   162	# --- Push branch ---
   163	PUSH_STDERR=$(mktemp)
   164	if ! git push -u origin HEAD >"$PUSH_STDERR" 2>&1; then
   165	    larch_err "ERROR: Failed to push branch: $(cat "$PUSH_STDERR")"
   166	    exit 1
   167	fi
   168	
   169	# --- Create PR ---
   170	PR_STDERR_FILE=$(mktemp)
   171	PR_STDOUT_FILE=$(mktemp)
   172	GH_DRAFT_ARGS=()
   173	if [[ "$DRAFT" == "true" ]]; then
   174	    GH_DRAFT_ARGS+=(--draft)
   175	fi
   176	
   177	if [[ -z "$BASE_REF" ]]; then
   178	    BASE_REF=$(gh repo view ${GH_REPO_ARGS[@]+"${GH_REPO_ARGS[@]}"} --json defaultBranchRef --jq '.defaultBranchRef.name' 2>/dev/null) || BASE_REF=""
   179	    if [[ -z "$BASE_REF" ]]; then
   180	        BASE_REF="main"
   181	    fi
   182	fi
   183	
   184	# Build the argv for diagnostic purposes (redact title/body values, keep flags),
   185	# then pass it through the shared tmpdir redactor before logging it.
   186	GH_CREATE_ARGV="gh pr create ${GH_REPO_ARGS[*]+${GH_REPO_ARGS[*]}} --assignee @me --head $BRANCH --base $BASE_REF --title <redacted> --body-file <redacted> ${GH_DRAFT_ARGS[*]+${GH_DRAFT_ARGS[*]}}"
   187	GH_CREATE_ARGV=$(printf '%s\n' "$GH_CREATE_ARGV" | "$REDACT_TMPDIR_HELPER")
   188	
   189	# Capture stdout to a tmpfile (for last-10-lines diagnostic) while stderr goes
   190	# to PR_STDERR_FILE.  Use set +e/-e to prevent set -e from firing on gh non-zero
   191	# before PR_EXIT=$? is reached.
   192	set +e
   193	PR_OUTPUT=$(gh pr create \
   194	    ${GH_REPO_ARGS[@]+"${GH_REPO_ARGS[@]}"} \
   195	    --assignee @me \
   196	    --head "$BRANCH" \
