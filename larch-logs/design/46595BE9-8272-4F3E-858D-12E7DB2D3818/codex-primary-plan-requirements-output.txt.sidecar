   101	stage_round_artifact() {
   102	    local input="$1"
   103	    local output="$2"
   104	    local name trim_tmp
   105	    name="$(basename "$input")"
   106	    trim_tmp="$(mktemp "${TMPDIR:-/tmp}/larch-log-round-trim.XXXXXX")" || larch_log_fail 2 "cannot create round trim temp"
   107	    (
   108	        trap 'rm -f "$trim_tmp"' EXIT
   109	        case "$name" in
   110	            *.meta)
   111	                larch_redact_strip_meta_cmd_json "$input" "$trim_tmp" || larch_log_fail 2 "cannot trim meta sidecar: $input"
   112	                ;;
   113	            *-output.txt.json|*-output-*.txt.json)
   114	                larch_redact_strip_json_result "$input" "$trim_tmp" || larch_log_fail 2 "cannot trim json sidecar: $input"
   115	                ;;
   116	            *)
   117	                cp "$input" "$trim_tmp" || larch_log_fail 2 "cannot stage round artifact: $input"
   118	                ;;
   119	        esac
   120	        larch_log_redact_file "$trim_tmp" "$output"
   121	    )
   122	}
