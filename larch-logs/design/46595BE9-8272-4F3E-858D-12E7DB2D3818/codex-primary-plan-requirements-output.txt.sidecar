     1	#!/usr/bin/env bash
     2	# tracking-issue-write.sh — outbound helper for the tracking-issue lifecycle.
     3	#
     4	# Phase 1 (umbrella #348) foundation layer. Ships narrow subcommands —
     5	# create-issue, append-comment, rename, and mark-false-positive — that each
     6	# perform exactly one GitHub write while sharing the same KEY=value stdout envelope and
     7	# fail-closed redaction posture as skills/issue/scripts/create-one.sh.
     8	#
     9	# Subcommands:
    10	#   create-issue   --title T --body-file F [--repo OWNER/REPO]
    11	#   append-comment --issue N --body-file F [--lifecycle-marker ID] [--repo OWNER/REPO]
    12	#   rename         --issue N --state in-progress|done|stalled [--round-trip BOOL] [--repo OWNER/REPO]
    13	#   mark-false-positive --issue N [--repo OWNER/REPO]
    14	#
    15	# Output contract (KEY=value on stdout; warnings on stderr). NAMESPACE note:
    16	# this script emits FAILED=true / ERROR=<msg> on failure — NOT the
    17	# ISSUE_FAILED=true / ISSUE_ERROR=<msg> prefix used by
    18	# skills/issue/scripts/create-one.sh. The divergence is intentional; this
    19	# script is not an /issue layer component. Consumers must parse for the
    20	# FAILED= / ERROR= prefix exactly. Parsers must also use the ERROR= field
    21	# (not exit code alone) to distinguish error kinds because exit 1 covers
    22	# both invocation-usage errors and validated-content rejections.
    23	#
    24	# Success keys:
    25	#   create-issue:   ISSUE_NUMBER=<N>  ISSUE_URL=<url>
    26	#   append-comment: COMMENT_ID=<id>   COMMENT_URL=<url>
    27	#   rename:         RENAMED=true|false  NEW_TITLE=<title>
    28	#                   ROUND_TRIP_APPLIED=true|false (only when --round-trip was passed)
    29	#   mark-false-positive: MARKED=true|false  NEW_TITLE=<title>
    30	#
    31	# Rename semantics (tracking-issue title-prefix lifecycle):
    32	#   Strips exactly ONE leading lifecycle prefix (anchored regex
    33	#   ^\[(IN PROGRESS|DONE|STALLED)\] ) from the current title, preserves or
    34	#   adds the optional strict-ASCII "[ROUND-TRIP] " marker, then prepends the
    35	#   target-state prefix. Lifecycle prefix order is fixed: lifecycle first,
    36	#   round-trip second. No-op when the composed title matches the current
    37	#   canonical title (RENAMED=false). The new title is piped through
    38	#   scripts/redact-secrets.sh before the gh call, matching the security
    39	#   posture of create-issue. Stacked-prefix corruption (e.g., "[IN PROGRESS]
    40	#   [DONE] Foo") is NOT healed — only one lifecycle prefix is stripped.
    41	#   Title length: truncated to 256 chars by preserving the managed prefixes
    42	#   and slicing only the user tail. GitHub's limit is 256 characters —
    43	#   matching bash's native length under UTF-8 locales. Managed prefixes are
    44	#   ASCII so truncation is stable regardless of locale.
    45	#
    46	# Failure keys:
    47	#   FAILED=true  ERROR=<single-line message>
    48	#
    49	# Exit codes:
    50	#   0 — success
    51	#   1 — invocation-usage error OR validated-content rejection (disambiguate via ERROR=)
    52	#   2 — gh failure OR fail-closed content-state error (e.g., multiple anchor
    53	#       comments found) — FAILED=true / ERROR= already emitted on stdout.
    54	#       Includes stderr-side fail-closed paths in redact_gh_error (pipeline
    55	#       unavailable, non-zero helper exit, or truncation marker in helper
    56	#       output): those use this same exit 2 envelope with a generic token-free
    57	#       ERROR=, not exit 3.
    58	#   3 — body/title compose-time redaction helper failure only (FAILED=true /
    59	#       ERROR=redaction:… via emit_redaction_failure)
    60	#
    61	# Security posture (see SECURITY.md "tracking-issue-write.sh outbound path"):
    62	#   * Structural choke point — compose full logical body in memory, pipe
    63	#     through scripts/redact-secrets.sh, THEN apply truncation. Never the
    64	#     reverse. Token-shaped byte sequences must not be sliced before
    65	#     redaction. Placement mirrors create-one.sh's single-choke-point
    66	#     comment.
    67	#   * gh-failure redaction (fail-closed) — every gh invocation captures
    68	#     stderr separately. On non-success paths, captured stderr is passed
    69	#     through redact_gh_error, which runs the full redact-tmpdir-paths.sh |
    70	#     redact-secrets.sh pipeline. If that pipeline is unavailable, exits
    71	#     non-zero, or emits the truncation marker ([content truncated —
    72	#     unterminated PEM block…]), a generic token-free string is emitted in
    73	#     ERROR= and no original stderr bytes are included; the caller still exits
    74	#     2 (gh failure class), not 3 (compose-time redaction helper class).
    75	#   * Summary comments are owned by tracking-issue-summary.sh; durable run
    76	#     payloads are owned by larch-log.sh.
    77	#
    78	# Conventions:
    79	#   Uses Bash 3.2-compatible constructs (indexed arrays only; no
    80	#   associative arrays, no `mapfile`) so macOS-default bash runs match
    81	#   Ubuntu CI. Precedent: scripts/dialectic-smoke-test.sh.
    82	#   Truncation is intentionally not applied here anymore; bulky run payloads
    83	#   live in committed larch-logs files rather than in GitHub comments.
    84	
    85	set -euo pipefail
    86	
    87	SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    88	# shellcheck source=scripts/lib-quiet.sh
    89	source "$SCRIPT_DIR/lib-quiet.sh"
    90	larch_quiet_init
    91	REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
    92	REDACT_HELPER="$REPO_ROOT/scripts/redact-secrets.sh"
    93	REDACT_TMPDIR_HELPER="$REPO_ROOT/scripts/redact-tmpdir-paths.sh"
    94	
    95	TITLE_MARKERS_HELPER="$SCRIPT_DIR/lib-title-markers.sh"
    96	
    97	usage() {
    98	    while IFS= read -r line; do larch_err "$line"; done <<'USAGE'
    99	Usage:
   100	  tracking-issue-write.sh create-issue   --title T --body-file F [--repo OWNER/REPO]
   101	  tracking-issue-write.sh append-comment --issue N --body-file F [--lifecycle-marker ID] [--repo OWNER/REPO]
   102	  tracking-issue-write.sh rename         --issue N --state in-progress|done|stalled [--round-trip BOOL] [--repo OWNER/REPO]
   103	  tracking-issue-write.sh mark-false-positive --issue N [--repo OWNER/REPO]
   104	USAGE
   105	}
   106	
   107	# State-to-prefix mapping for the rename subcommand. Using a function rather
   108	# than an associative array keeps us Bash 3.2 compatible (see top-of-file
   109	# conventions).
   110	state_to_prefix() {
   111	    case "$1" in
   112	        in-progress) printf '[IN PROGRESS] ' ;;
   113	        done)        printf '[DONE] ' ;;
   114	        stalled)     printf '[STALLED] ' ;;
   115	        *)           return 1 ;;
   116	    esac
   117	}
   118	
   119	# strip_lifecycle_prefix <title> — prints the title with exactly ONE leading
   120	# lifecycle prefix removed (if present). Anchored at the start; stacked
   121	# prefixes beyond the first are preserved. Uses shell parameter expansion
   122	# so the stripper is regex-engine-agnostic and safe for bash 3.2.
   123	strip_lifecycle_prefix() {
   124	    local t="$1"
   125	    case "$t" in
   126	        '[IN PROGRESS] '*) printf '%s' "${t#\[IN PROGRESS\] }" ;;
   127	        '[DONE] '*)        printf '%s' "${t#\[DONE\] }" ;;
   128	        '[STALLED] '*)     printf '%s' "${t#\[STALLED\] }" ;;
   129	        *)                 printf '%s' "$t" ;;
   130	    esac
   131	}
   132	
   133	# has_round_trip_prefix <title-after-lifecycle-strip> — true iff the title
   134	# begins with the exact managed marker. Lowercase, Unicode-homoglyph, or
   135	# missing-space variants are user content.
   136	has_round_trip_prefix() {
   137	    case "$1" in
   138	        '[ROUND-TRIP] '*) return 0 ;;
   139	        *)               return 1 ;;
   140	    esac
   141	}
   142	
   143	# strip_round_trip_prefix <title-after-lifecycle-strip> — prints the title
   144	# with at most one exact managed round-trip marker removed.
   145	strip_round_trip_prefix() {
   146	    local t="$1"
   147	    case "$t" in
   148	        '[ROUND-TRIP] '*) printf '%s' "${t#\[ROUND-TRIP\] }" ;;
   149	        *)                printf '%s' "$t" ;;
   150	    esac
   151	}
   152	
   153	# truncate_title_with_prefixes_to_256 <prefixes> <user-tail> —
   154	# character-oriented truncation to 256 chars using bash string semantics
   155	# (`${#var}` + slice). GitHub's title limit is 256 characters, matching
   156	# bash's native string semantics under UTF-8 locales. Preserves both managed
   157	# prefixes at the head and slices only the user tail. The optional round-trip
   158	# marker is exactly 13 ASCII chars including the trailing space.
   159	truncate_title_with_prefixes_to_256() {
   160	    local prefixes="$1"
   161	    local tail="$2"
   162	    local budget=$((256 - ${#prefixes}))
   163	    if (( budget < 0 )); then
   164	        budget=0
   165	    fi
   166	    if (( ${#prefixes} + ${#tail} <= 256 )); then
   167	        printf '%s%s' "$prefixes" "$tail"
   168	    else
   169	        printf '%s%s' "$prefixes" "${tail:0:$budget}"
   170	    fi
   171	}
   172	
   173	# truncate_title_to_256 <title> — character-oriented truncation to 256
   174	# chars using bash string semantics. Used by `mark-false-positive`, where
   175	# the marker is inserted into the leading bracket-block sequence by
   176	# insert_signal_marker (lib-title-markers.sh) and the resulting title is
   177	# truncated as a whole; rename uses truncate_title_with_prefixes_to_256
   178	# instead because it composes lifecycle + round-trip prefixes explicitly.
   179	truncate_title_to_256() {
   180	    local t="$1"
   181	    if (( ${#t} <= 256 )); then
   182	        printf '%s' "$t"
   183	    else
   184	        printf '%s' "${t:0:256}"
   185	    fi
   186	}
   187	
   188	# emit_redaction_failure — runs outside command substitution (via `|| ...`)
   189	# so its echo lines reach the parent's stdout for callers parsing
   190	# ^FAILED= / ^ERROR= on stdout, then exits 3. The helper is required:
   191	# there is no fallback to un-redacted content per the fail-closed
   192	# defense-in-depth design.
   193	emit_redaction_failure() {
   194	    local rc=$?
   195	    emit_kv FAILED "true"
   196	    if [ "$rc" -eq 10 ]; then
   197	        emit_kv ERROR "redaction: helper redact-tmpdir-paths.sh failed or missing"
   198	    else
   199	        emit_kv ERROR "redaction: helper $REDACT_HELPER failed or missing"
   200	    fi
   201	    exit 3
   202	}
   203	
   204	# redact <text> — prints redacted text on stdout, returns the helper's
   205	# exit code. Callers MUST invoke this via command substitution combined
   206	# with `|| emit_redaction_failure`, because inside command substitution any
   207	# stdout emission is captured into the assigning variable rather than the
   208	# parent's stdout. Do NOT swallow stderr: redact-secrets.sh emits a WARN on
   209	# stderr when an unterminated PEM block forces fail-closed truncation, and
   210	# that signal is the only log-visibility mechanism for that condition.
   211	redact() {
   212	    [ -x "$REDACT_TMPDIR_HELPER" ] || return 10
   213	    [ -x "$REDACT_HELPER" ] || return 11
   214	    printf '%s' "$1" | "$REDACT_TMPDIR_HELPER" | "$REDACT_HELPER"
   215	}
   216	
   217	# redact_gh_error <captured-stderr-text> — scrubs 4xx API responses /
   218	# token-bearing error text before emission in ERROR=. Fails closed: if the
   219	# redact pipeline is unavailable, exits non-zero, or emits the truncation
   220	# marker, a generic token-free string is returned and no original stderr

