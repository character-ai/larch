     9	if [ "${LARCH_LIB_QUIET_LOADED:-}" = "1" ]; then
    10	    return 0 2>/dev/null || exit 0
    11	fi
    12	LARCH_LIB_QUIET_LOADED=1
    13	
    14	larch_quiet_truthy() {
    15	    case "${1:-}" in
    16	        1|true|TRUE|True|yes|YES|Yes|on|ON|On) return 0 ;;
    17	        *) return 1 ;;
    18	    esac
    19	}
    20	
    21	larch_quiet_default_log() {
    22	    local base script tmp
    23	    base="${0##*/}"
    24	    script=${base:-larch-script}
    25	    if [ -n "${IMPLEMENT_TMPDIR:-}" ] && [ -d "$IMPLEMENT_TMPDIR" ]; then
    26	        tmp="$IMPLEMENT_TMPDIR"
    27	    elif [ -n "${REVIEW_TMPDIR:-}" ] && [ -d "$REVIEW_TMPDIR" ]; then
    28	        tmp="$REVIEW_TMPDIR"
