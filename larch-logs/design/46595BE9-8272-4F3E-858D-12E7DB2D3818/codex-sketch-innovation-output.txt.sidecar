gs\\n' >> \"$IMPLEMENT_TMPDIR/larch-log-batches-input/code-review-tally.md\"\n    cat \"$IMPLEMENT_TMPDIR/rejected-findings.md\" >> \"$IMPLEMENT_TMPDIR/larch-log-batches-input/code-review-tally.md\"\nfi\n\n<OPERATOR_REPO_PATH>/plugins/cache/larch-local/larch/34.0.3/scripts/write-tally.sh \\\n    --log-root \"$IMPLEMENT_TMPDIR/larch-logs\" \\\n    --skill implement --run-id \"$RUN_ID\" \\\n    --phase code-review --mode hard \\\n    --rounds \"$rounds\" --accepted \"$accepted\" --rejected \"$rejected\" \\\n    --exonerated \"$exonerated\" --neutral \"$neutral\" \\\n    --body-file \"$IMPLEMENT_TMPDIR/larch-log-batches-input/code-review-tally.md\"","description":"Write code-review-tally larch-log batch"}}]}
