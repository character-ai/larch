   181	  "started_at": "$ts",
   182	  "updated_at": "$ts",
   183	  "attempt": 1,
   184	  "superseded_by": null,
   185	  "stalled_at_step": null,
   186	  "steps_ran": {},
   187	  "flags": {}
   188	}
