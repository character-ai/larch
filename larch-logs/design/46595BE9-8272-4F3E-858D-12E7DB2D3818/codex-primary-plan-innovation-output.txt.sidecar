    85	refresh_ci_state() {
    86	    # Use gh pr checks --json with bucket field (consistent with ci-status.sh)
    87	    CHECKS_JSON=$(gh pr checks "$PR_NUMBER" --repo "$REPO" --json name,state,bucket,link 2>/dev/null || echo "")
