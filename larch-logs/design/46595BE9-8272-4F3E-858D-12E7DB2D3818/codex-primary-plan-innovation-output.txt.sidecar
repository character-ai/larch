    47	usage() { larch_err "Usage: merge-pr.sh --pr NUMBER --repo OWNER/REPO [--no-admin-fallback]"; }
    48	
    49	# --- Parse arguments (before installing EXIT trap) ---
    50	PR_NUMBER=""
    51	REPO=""
    52	NO_ADMIN_FALLBACK=false
    53	while [[ $# -gt 0 ]]; do
    54	    case "$1" in
    55	        --pr) PR_NUMBER="${2:?--pr requires a value}"; shift 2 ;;
    56	        --repo) REPO="${2:?--repo requires a value}"; shift 2 ;;
    57	        --no-admin-fallback) NO_ADMIN_FALLBACK=true; shift ;;
    58	        --help) usage; exit 0 ;;
    59	        *) larch_err "Unknown option: $1"; usage; exit 1 ;;
