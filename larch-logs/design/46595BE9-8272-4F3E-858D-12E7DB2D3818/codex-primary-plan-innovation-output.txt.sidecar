     1	#!/usr/bin/env bash
     2	# create-branch.sh — Branch creation for /design skill.
     3	#
     4	# Two modes:
     5	#   --check          Output current branch state (no side effects)
     6	#   --branch NAME    Create a new branch from latest origin/main
     7	#
     8	# Usage:
     9	#   create-branch.sh --check
    10	#   create-branch.sh --branch <branch-name>
    11	#
    12	# Outputs (key=value to stdout):
    13	#   --check mode:
    14	#     CURRENT_BRANCH=<name>     (empty if detached HEAD)
    15	#     IS_MAIN=true|false
    16	#     IS_USER_BRANCH=true|false
    17	#     USER_PREFIX=<value>       (derived from git config user.name)
    18	#
    19	#   --branch mode:
    20	#     BRANCH_NAME=<name>
    21	#     ACTION=created
    22	#
    23	# Exit codes:
    24	#   0 — success
    25	#   1 — branch already exists (--branch mode only)
    26	#   2 — git operation failed
    27	
    28	set -euo pipefail
    29	
    30	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    31	# shellcheck source=scripts/lib-quiet.sh
    32	source "$SCRIPT_DIR/lib-quiet.sh"
    33	larch_quiet_init
    34	
    35	usage() { larch_err "Usage: create-branch.sh --check | create-branch.sh --branch NAME"; }
    36	
    37	# Derive user prefix from git config user.name:
    38	# lowercase, spaces→hyphens, strip non-alphanumeric-hyphens, truncate to 20 chars, fallback "dev"
    39	derive_user_prefix() {
    40	    local raw
    41	    raw=$(git config user.name 2>/dev/null || echo "")
    42	    if [[ -z "$raw" ]]; then
    43	        echo "dev"
    44	        return
    45	    fi
    46	    local sanitized
    47	    sanitized=$(printf '%s\n' "$raw" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | sed 's/[^a-z0-9-]//g' | head -c 20 | sed 's/-*$//')
    48	    if [[ -z "$sanitized" ]]; then
    49	        echo "dev"
    50	        return
    51	    fi
    52	    echo "$sanitized"
    53	}
    54	
    55	MODE=""
    56	BRANCH_NAME=""
    57	while [[ $# -gt 0 ]]; do
    58	    case "$1" in
    59	        --check) MODE="check"; shift ;;
    60	        --branch) MODE="create"; BRANCH_NAME="${2:?--branch requires a value}"; shift 2 ;;
    61	        --help) usage; exit 0 ;;
    62	        *) larch_err "Unknown option: $1"; usage; exit 2 ;;
    63	    esac
    64	done
    65	
    66	if [[ -z "$MODE" ]]; then
    67	    larch_err "ERROR: --check or --branch is required"
    68	    usage; exit 2
    69	fi
    70	
    71	USER_PREFIX=$(derive_user_prefix)
    72	
    73	if [[ "$MODE" == "check" ]]; then
    74	    # --- Check mode: report current branch state ---
    75	    CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
    76	
    77	    IS_MAIN="false"
    78	    IS_USER_BRANCH="false"
    79	
    80	    if [[ -z "$CURRENT_BRANCH" ]] || [[ "$CURRENT_BRANCH" == "main" ]]; then
    81	        IS_MAIN="true"
    82	    elif [[ "$CURRENT_BRANCH" == "${USER_PREFIX}"/* ]]; then
    83	        IS_USER_BRANCH="true"
    84	    fi
    85	
    86	    emit_kv CURRENT_BRANCH "$CURRENT_BRANCH"
    87	    emit_kv IS_MAIN "$IS_MAIN"
    88	    emit_kv IS_USER_BRANCH "$IS_USER_BRANCH"
    89	    emit_kv USER_PREFIX "$USER_PREFIX"
    90	    exit 0
    91	fi
    92	
    93	# --- Create mode: create branch from latest main ---
    94	
    95	# Validate branch name format
    96	if [[ ! "$BRANCH_NAME" == "${USER_PREFIX}"/* ]]; then
    97	    larch_err "ERROR: Branch name must start with '${USER_PREFIX}/': $BRANCH_NAME"
    98	    exit 2
    99	fi
   100	
   101	# Check if branch already exists
   102	if git show-ref --verify --quiet "refs/heads/$BRANCH_NAME" 2>/dev/null; then
   103	    larch_err "ERROR: Branch already exists: $BRANCH_NAME"
   104	    exit 1
   105	fi
   106	
   107	# Fetch latest main and create branch directly from origin/main
   108	# (avoids unnecessary checkout main + pull round-trip)
   109	if ! git fetch origin main --quiet >/dev/null 2>&1; then
   110	    larch_err "ERROR: Failed to fetch origin/main"
   111	    exit 2
   112	fi
   113	
   114	if ! git checkout -b "$BRANCH_NAME" origin/main >/dev/null 2>&1; then
   115	    larch_err "ERROR: Failed to create branch: $BRANCH_NAME"
   116	    exit 2
   117	fi
   118	
   119	emit_kv BRANCH_NAME "$BRANCH_NAME"
   120	emit_kv ACTION created

