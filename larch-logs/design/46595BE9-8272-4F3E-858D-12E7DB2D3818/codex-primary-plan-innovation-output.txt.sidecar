   200	case "$cmd" in
   201	    init)
   202	        LOG_ROOT=""; SKILL=""; RUN_ID=""; PARENT_SKILL=""; ISSUE=""
   203	        while [ $# -gt 0 ]; do
   204	            case "$1" in
