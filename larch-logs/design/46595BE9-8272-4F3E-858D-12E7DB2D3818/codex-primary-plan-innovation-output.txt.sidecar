   210	                *) usage; larch_log_fail 1 "unknown option for init: $1" ;;
   211	            esac
   212	        done
   213	        require_log_root
   214	        require_common
   215	        [ -z "$PARENT_SKILL" ] || larch_log_validate_slug parent-skill "$PARENT_SKILL"
   216	        case "$ISSUE" in ""|*[!0-9]*) [ -z "$ISSUE" ] || larch_log_fail 1 "invalid issue: $ISSUE" ;; esac
